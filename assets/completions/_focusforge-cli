#compdef focusforge-cli

autoload -U is-at-least

_focusforge-cli() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'*-v[Increase log detail (repeatable)]' \
'-q[Log errors only]' \
'--quiet[Log errors only]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_focusforge-cli_commands" \
"*::: :->focusforge-cli" \
&& ret=0
    case $state in
    (focusforge-cli)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:focusforge-cli-command-$line[1]:"
        case $line[1] in
            (info)
_arguments "${_arguments_options[@]}" : \
'--json[Emit the JSON document instead of human-readable text]' \
'*-v[Increase log detail (repeatable)]' \
'-q[Log errors only]' \
'--quiet[Log errors only]' \
'-h[Print help]' \
'--help[Print help]' \
':path -- Path to a file or directory:_files' \
&& ret=0
;;
(algorithms)
_arguments "${_arguments_options[@]}" : \
'*--set=[Set a parameter\: \`--set key=value\`, repeatable. A repeated key is last-wins]:KEY=VALUE:_default' \
'--json[Emit the JSON document instead of human-readable text]' \
'*-v[Increase log detail (repeatable)]' \
'-q[Log errors only]' \
'--quiet[Log errors only]' \
'-h[Print help]' \
'--help[Print help]' \
'::id -- Algorithm id. Omit to list every registered algorithm:_default' \
&& ret=0
;;
(stack)
_arguments "${_arguments_options[@]}" : \
'-o+[Directory to collect this run'\''s projects into. Omit to write each project beside its own frames]:DIR:_files' \
'--output=[Directory to collect this run'\''s projects into. Omit to write each project beside its own frames]:DIR:_files' \
'--algorithm=[Registered stacking algorithm id (\`focusforge-cli algorithms\` lists them). Required unless a \`--preset\` supplies \`algo\`]:ALGO:_default' \
'*--set=[Set a parameter\: \`--set key=value\`, repeatable. A repeated key is last-wins]:KEY=VALUE:_default' \
'--groups=[Group the frames as this TOML file says instead of proposing a grouping\: one \`\[\[group\]\]\` block per stack, each with a \`name\` and a \`frames\` array of paths relative to \`<dir>\`. Every frame found under \`<dir>\` must appear in exactly one group]:PATH:_files' \
'--write-groups=[Write the proposed grouping to this path, in exactly the format \`--groups\` reads, then carry on with the run. Edit it and feed it back with \`--groups\` to override the proposal]:PATH:_files' \
'*--only=[Run only the named result(s), repeatable\: matches a group'\''s identity (what \`review --json\`'\''s \`identity\` field prints, and what this run'\''s own \`--status\` stream uses) or its plain name. Every unselected group is skipped -- named on stderr, not re-run -- and its project on disk is left untouched. Combine with \`--set\`/\`--align-set\` to cheaply re-run a subset after changing a fusion or alignment parameter]:ID:_default' \
'--align-algorithm=[Alignment algorithm id. Optional\: defaults to the sole registered alignment algorithm, refusing (and listing the choices) when more than one is registered]:ALIGN_ALGO:_default' \
'*--align-set=[Set an alignment parameter\: \`--align-set key=value\`, repeatable. A repeated key is last-wins]:KEY=VALUE:_default' \
'--tile-size=[Override the scheduler'\''s outer tile size, in pixels. Omit to use the scheduler'\''s own default]:PX:_default' \
'--max-host-memory=[A **ceiling only** on the adaptive host-memory budget\: it can lower the budget the host-derived estimate resolved to, and can never raise it. Nobody has to pass this to get the machine'\''s own concurrency -- omit it entirely and the budget is derived from the host. Accepts suffixed sizes (\`8GiB\`, \`512MiB\`, \`4096\`)]:SIZE:_default' \
'--max-vram=[A **ceiling only** on the adaptive device (VRAM) budget\: it can lower the budget the startup probe settled on, and can never raise it. Omit it entirely to get the probed value. Accepts the same suffixed sizes as \`--max-host-memory\`. Only present when the \`gpu\` feature is compiled in]:SIZE:_default' \
'--preset=[Read parameter values from a TOML preset\: the \`algo\` and \`align-algo\` keys plus the \`\[stack\]\` and \`\[align\]\` value tables. A flag always beats the file -- \`--set\`/\`--align-set\` override the tables, \`--algorithm\`/\`--align-algorithm\` override the keys]:PATH:_files' \
'--write-preset=[Write the preset that reproduces this run to this path\: the algorithm ids plus the values you actually chose. Values left to an \`auto\` closure stay live and are never frozen into the file]:PATH:_files' \
'--status=[Append one NDJSON status record for this stack to this path\: identity, outcome, outputs and the error, if any. Every terminal path writes exactly one record]:PATH:_files' \
'--json[Emit the JSON report instead of human-readable text]' \
'--no-align[Skip alignment\: frames are fused as read and the output keeps the full frame]' \
'--no-crop[Skip the auto-crop\: the output keeps the full frame extent even when alignment is on]' \
'--strict[Refuse the run when an alignment fails. Meaningless with \`--no-align\`]' \
'--resume[Resume a previously cancelled run of this same stack, found by stack fingerprint under \`.scratch/resume/\` -- no argument. Refuses at exit 1 when no matching scratch state exists or it disagrees with this invocation'\''s inputs]' \
'--no-progress[Print no stage progress]' \
'--dry-run[Resolve everything, print what would happen -- parameters with their provenance, tile geometry, output paths -- and exit 0 without computing or writing anything. Stops *before* alignment, so it reports no crop rect and no output extent]' \
'--cpu[Force the CPU path even when a usable GPU adapter is available. Only in builds with GPU support]' \
'--no-cache[Skip the stage cache\: recompute the alignment even when a valid entry exists, and store no new entry]' \
'*-v[Increase log detail (repeatable)]' \
'-q[Log errors only]' \
'--quiet[Log errors only]' \
'-h[Print help]' \
'--help[Print help]' \
':dir -- Directory of TIFF or supported RAW frames to fuse (non-recursive, descending into `<dir>/frames` when that subdirectory exists):_files' \
