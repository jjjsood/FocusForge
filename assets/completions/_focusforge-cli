(( $+functions[_focusforge-cli_commands] )) ||
_focusforge-cli_commands() {
    local commands; commands=(
'info:Print project, TIFF or RAW metadata for a file, or for every frame in a directory' \
'algorithms:List every registered algorithm, or print one named algorithm'\''s full parameter schema' \
'stack:Fuse supported TIFF or RAW frames of a directory into one **project** per detected stack, through a registered stacking algorithm. A run prepares projects for review; it does not export images -- run \`focusforge-cli export\` for that' \
'export:Turn a project into an image file\: the image with \`-o\`, the Z-Map with \`--zmap\`, either or both in one invocation. At least one of the two is required. This is the only command that writes an image' \
'retouch:Append an op list to a project as new states, one per op, each the previous one'\''s child\: on the current head, or on \`--from\` as a branch. \`export --checkpoint\` writes any of them' \
'history:List, delete or compact a project'\''s checkpoints. Every history operation is reachable through this command, headless' \
'align:Compute and report the per-frame transforms for a stack\: readable text by default, a \`--json\` document on request, and an optional per-frame warped-TIFF dump for a visual check' \
'review:Report one record per result found under a directory of projects, or a batch run'\''s output directory\: identity, outcome, sharpness ratio and Z-Map spread, with a failed stack a visible record rather than a missing file. Reads a run manifest when one is present, otherwise a non-recursive listing of \`*.ffp\` files; never groups frames itself and writes nothing' \
'cache:Remove every entry from the stage cache under \`.scratch/stage-cache/\`. Never touches \`.scratch/resume/\` or any project' \
'diagnostics:Package this installation'\''s logs, crash reports, system summary, graphics adapter record, effective configuration and version into one ZIP, listing every file before writing it. The home directory and the user name are redacted out of every text entry, image data is never included, and nothing is sent anywhere' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'focusforge-cli commands' commands "$@"
}
