//
// The design language as code.

import "../../../assets/fonts/Inter-Regular.ttf";
import "../../../assets/fonts/Inter-Medium.ttf";
import "../../../assets/fonts/Inter-SemiBold.ttf";

// Not exported: the raw ramp stays unreachable from any other .slint file
// or from Rust.
global Primitives {
    // Neutral ramp (Darkroom, Ramp A, Deep) -- 12 steps.
    out property <color> neutral-950: #080808;
    out property <color> neutral-900: #0E0E0E;
    out property <color> neutral-850: #121212;
    out property <color> neutral-800: #1A1A1A;
    out property <color> neutral-700: #242424;
    out property <color> neutral-600: #2E2E2E;
    out property <color> neutral-500: #3A3A3A;
    out property <color> neutral-400: #5A5A5A;
    out property <color> neutral-300: #7A7A7A; // in the ramp, bound by no semantic token
    out property <color> neutral-200: #9A9A9A;
    out property <color> neutral-100: #C8C8C8;
    out property <color> neutral-50: #F2F2F2;

    // Accent ramp (orange) -- matching assets/logo.svg.
    out property <color> orange-400: #F08A55;
    out property <color> orange-500: #E8763A;
    out property <color> orange-600: #C85F28;
    out property <color> orange-900: #2A1810;

    // Status colours -- a recorded exception to the one-accent rule.
    out property <color> red-500: #D9544D;
    out property <color> amber-500: #D9A441;
    out property <color> green-500: #5AA469;
}

// No field sizes a control to fit an English string; `EnumVariant.label`
// must stay free to translate to any length.
export struct TypeRole {
    size: length,
    weight: int,
    line-height: float,
    letter-spacing: length,
    uppercase: bool,
}

// Exported: every semantic colour is initialised from a `Primitives`
// member, never from a hex literal directly. A token name's dots become
// dashes and any internal camelCase becomes kebab-case, so
// `text.onAccent` -> `text-on-accent`, which Slint's codegen turns into
// `get_text_on_accent()` on the Rust side.
export global Theme {
    // Surfaces
    out property <color> surface-canvas: Primitives.neutral-950;
    out property <color> surface-base: Primitives.neutral-850;
    out property <color> surface-raised: Primitives.neutral-800;
    out property <color> surface-overlay: Primitives.neutral-700;
    out property <color> surface-hover: Primitives.neutral-700;
    out property <color> surface-disabled: Primitives.neutral-500;

    // Borders
    out property <color> border-default: Primitives.neutral-600;
    out property <color> border-strong: Primitives.neutral-500;

    // Text
    out property <color> text-primary: Primitives.neutral-50;
    out property <color> text-secondary: Primitives.neutral-100;
    out property <color> text-muted: Primitives.neutral-200;
    out property <color> text-disabled: Primitives.neutral-400;
    out property <color> text-on-accent: Primitives.neutral-950;
    // The brush cursor's ink, independent of `text-on-accent`'s meaning.
    out property <color> cursor-ink: Primitives.neutral-950;

    // Accent, with its interaction states
    out property <color> accent-default: Primitives.orange-500;
    out property <color> accent-hover: Primitives.orange-400;
    out property <color> accent-pressed: Primitives.orange-600;
    out property <color> accent-subtle: Primitives.orange-900;

    // Status -- the three recorded exceptions
    out property <color> status-failure: Primitives.red-500;
    out property <color> status-warning: Primitives.amber-500;
    out property <color> status-success: Primitives.green-500;

    // Type
    out property <string> font-family: "Inter";
    out property <TypeRole> text-section: {
        size: 10px, weight: 600, line-height: 1.2, letter-spacing: 0.6px, uppercase: true,
    };
    out property <TypeRole> text-body: {
        size: 12px, weight: 400, line-height: 1.45, letter-spacing: 0px, uppercase: false,
    };
    out property <TypeRole> text-value: {
        size: 12px, weight: 500, line-height: 1.45, letter-spacing: 0px, uppercase: false,
    };
    out property <TypeRole> text-emphasis: {
        size: 13px, weight: 400, line-height: 1.4, letter-spacing: 0px, uppercase: false,
    };
    out property <TypeRole> text-title: {
        size: 15px, weight: 600, line-height: 1.3, letter-spacing: 0px, uppercase: false,
    };
    out property <TypeRole> text-display: {
        size: 20px, weight: 600, line-height: 1.25, letter-spacing: 0px, uppercase: false,
    };

    // Spacing -- named by step, not by sequential index.
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;
    out property <length> space-12: 48px;

    // Radii -- a flat scale, deliberately not the brand's 22% corner.
    out property <length> radius-sm: 3px;
    out property <length> radius-md: 5px;
    out property <length> radius-lg: 8px;
    out property <length> radius-full: 999px;

    // Icon size ladder -- 20 / 16 / 14. 24 is the construction grid, not
    // a ladder size.
    out property <length> icon-lg: 20px;
    out property <length> icon-md: 16px;
    out property <length> icon-sm: 14px;

    // Motion animates the tab strip's scroll. An easing cannot be a
    // property, so every `animate` using motion-fast pairs it with ease-out.
    out property <duration> motion-fast: 150ms;
    // A slower fade for a notice that must be readable while it moves, not
    // just acknowledged -- the failure toast's own appear/disappear.
    out property <duration> motion-slow: 400ms;
}

// Empty on purpose: a handle so a test can reach a global.
export component ThemeProbe inherits Window { }
