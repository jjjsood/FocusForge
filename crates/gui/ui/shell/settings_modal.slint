// SPDX-License-Identifier: GPL-3.0-or-later
//
// The settings modal: reachable only through the bottom bar's gear. Ships
// the six-section nav rail plus the `Input map` section's read-only
// three-column table and its provenance line; the other four sections are
// a mockup only -- nothing there is editable.

import { Theme } from "../theme.slint";

export struct InputRow {
    input: string,
    stacking: string,
    editor: string,
}

component FFNavRailEntry inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;

    height: 36px;
    background: root.selected ? Theme.surface-hover : transparent;
    border-radius: Theme.radius-sm;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;
        alignment: start;

        Image {
            source: @image-url("../../../../assets/icons/keyboard.svg");
            colorize: root.selected ? Theme.accent-default : Theme.text-secondary;
            width: Theme.icon-md;
            height: Theme.icon-md;
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.text-body.size;
            font-weight: Theme.text-body.weight;
            vertical-alignment: center;
        }
    }
}

component FFInputTableRow inherits Rectangle {
    in property <string> input-label: "";
    in property <string> stacking-label: "";
    in property <string> editor-label: "";
    in property <bool> header: false;

    height: 32px;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;

        Text {
            text: root.input-label;
            color: root.header ? Theme.text-muted : Theme.text-primary;
            font-size: Theme.text-body.size;
            font-weight: root.header ? Theme.text-section.weight : Theme.text-body.weight;
            width: 36%;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            text: root.stacking-label;
            color: root.header ? Theme.text-muted : Theme.text-secondary;
            font-size: Theme.text-body.size;
            font-weight: root.header ? Theme.text-section.weight : Theme.text-body.weight;
            width: 32%;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            text: root.editor-label;
            color: root.header ? Theme.text-muted : Theme.text-secondary;
            font-size: Theme.text-body.size;
            font-weight: root.header ? Theme.text-section.weight : Theme.text-body.weight;
            width: 32%;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

export component FFSettingsModal inherits Rectangle {
    in property <bool> settings-open: false;
    in property <[InputRow]> input-rows: [];
    in property <string> input-provenance: "";
    callback settings-close-requested();

    visible: root.settings-open;

    // Theme ships no dedicated scrim token, so an existing surface token
    // dimmed with `with-alpha` stands in rather than a raw colour-function
    // call -- `no_colour_literal_outside_the_theme` refuses both alike.
    scrim := Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface-canvas.with-alpha(0.6);
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 720px;
        height: 420px;
        background: Theme.surface-raised;
        border-radius: Theme.radius-lg;
        clip: true;

        nav-rail := Rectangle {
            x: 0px;
            y: 0px;
            width: 160px;
            height: parent.height;
            background: Theme.surface-base;

            FFNavRailEntry {
                x: Theme.space-2;
                y: Theme.space-3;
                width: parent.width - 2 * Theme.space-2;
                label: "Input map";
                selected: true;
            }
        }

        close := TouchArea {
            x: parent.width - Theme.space-3 - self.width;
            y: Theme.space-3;
            width: Theme.icon-md;
            height: Theme.icon-md;

            clicked => { root.settings-close-requested(); }

            Image {
                source: @image-url("../../../../assets/icons/x.svg");
                colorize: Theme.text-secondary;
                width: Theme.icon-md;
                height: Theme.icon-md;
            }
        }

        content := Rectangle {
            x: nav-rail.width;
            y: 0px;
            width: parent.width - nav-rail.width;
            height: parent.height;

            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-2;

                Text {
                    text: "Input map";
                    color: Theme.text-primary;
                    font-size: Theme.text-title.size;
                    font-weight: Theme.text-title.weight;
                }

                provenance := Text {
                    text: root.input-provenance;
                    color: Theme.text-muted;
                    font-size: Theme.text-body.size;
                }

                FFInputTableRow {
                    header: true;
                    input-label: "Input";
                    stacking-label: "Stacking";
                    editor-label: "Editor";
                }

                for row[i] in root.input-rows: FFInputTableRow {
                    input-label: row.input;
                    stacking-label: row.stacking;
                    editor-label: row.editor;
                }
            }
        }
    }
}
