//
// The dock's stacking/editor mode switch: a pill track with an accent pill
// that slides under the active half; each label's colour follows how much of
// its half the pill covers.

import { Theme } from "../../theme.slint";
import { FFModeLabel } from "../../components/ff_mode_label.slint";
import { FFModePill } from "../../components/ff_mode_pill.slint";

export component FFModeSwitch inherits Rectangle {
    callback mode-selected(string);
    in property <bool> editor-enabled: false;
    in property <string> mode: "stacking";

    // How much of each half the sliding pill covers, 0 to 1.
    property <float> editor-cover: max(0.0, min(1.0, pill.x / pill.width));
    property <float> stacking-cover: 1.0 - root.editor-cover;

    height: 28px;
    background: Theme.surface-overlay;
    border-radius: min(Theme.radius-full, self.height / 2);

    pill := FFModePill {
        x: root.mode == "editor" ? root.width / 2 : 0px;
        width: root.width / 2;
        height: 100%;
        animate x { duration: Theme.motion-fast; easing: ease-out; }
    }

    HorizontalLayout {
        stacking-half := Rectangle {
            width: root.width / 2;
            FFModeLabel {
                text: "STACKING";
                cover: root.stacking-cover;
            }
            TouchArea {
                clicked => { root.mode-selected("stacking"); }
            }
        }
        editor-half := Rectangle {
            width: root.width / 2;
            FFModeLabel {
                text: "EDITOR";
                cover: root.editor-cover;
                disabled: !root.editor-enabled;
            }
            TouchArea {
                enabled: root.editor-enabled;
                clicked => { root.mode-selected("editor"); }
            }
        }
    }
}
