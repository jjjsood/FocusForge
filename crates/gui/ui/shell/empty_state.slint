//
// The empty state: the wordmark above one raised card with the title, copy,
// "Open…" button and drop caption; opaque, covers the canvas region.

import { Theme } from "../theme.slint";
import { ShellGeometry } from "../geometry.slint";
import { FFButton } from "../components/ff_button.slint";

export component FFEmptyState inherits Rectangle {
    in property <bool> drop-unavailable: false;
    callback open-requested();

    background: Theme.surface-base;

    VerticalLayout {
        x: 0px;
        y: -ShellGeometry.toolbar-height;
        width: 100%;
        height: 100%;
        alignment: center;
        // 44 px, wordmark bottom to card top.
        spacing: Theme.space-8 + Theme.space-3;

        HorizontalLayout {
            alignment: center;

            wordmark := Image {
                source: @image-url("../../../../assets/wordmark-horizontal-inverse.svg");
                width: 288px;
            }
        }

        HorizontalLayout {
            alignment: center;

            empty-card := Rectangle {
                width: 520px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-lg;

                VerticalLayout {
                    padding: Theme.space-8;
                    spacing: Theme.space-6;

                    VerticalLayout {
                        spacing: Theme.space-3;

                        empty-title := Text {
                            text: "No project open";
                            height: Theme.text-title.size * Theme.text-title.line-height;
                            color: Theme.text-primary;
                            font-size: Theme.text-title.size;
                            font-weight: Theme.text-title.weight;
                            vertical-alignment: center;
                        }

                        empty-body := Text {
                            text: "Choose the frames of one stack, or drop a folder: each stack it holds becomes its own project, in its own tab.";
                            color: Theme.text-muted;
                            font-size: Theme.text-body.size;
                            font-weight: Theme.text-body.weight;
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-3;

                        HorizontalLayout {
                            alignment: start;

                            open := FFButton {
                                width: 168px;
                                kind: "primary";
                                text: "Open…";
                                clicked => { root.open-requested(); }
                            }
                        }

                        drop-caption := Text {
                            text: root.drop-unavailable ? "Dropping is unavailable on native Wayland" : "Drop a folder or stack";
                            color: Theme.text-disabled;
                            font-size: Theme.text-body.size;
                            font-weight: Theme.text-body.weight;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
