//
// The bottom bar: the only band that spans the dock, because zoom, Fit and
// the ETA belong to the whole window. Otherwise an empty container except
// for the gear control at the left end, which reaches the `Input map`
// settings section, and the zoom cluster at the right end, its own file
// under `bottom_bar/` per the shell-region split, since `FFZoomCluster` is
// scoped-tested on its own.

import { Theme } from "../theme.slint";
import { ShellGeometry } from "../geometry.slint";

component FFZoomIconButton inherits Rectangle {
    in property <image> icon;
    // Greyed and inert while no project is open -- there is no viewport to
    // zoom, so a live-looking button next to a blank readout is misleading.
    in property <bool> enabled: true;
    callback pressed();

    // Token-derived, not a bare literal: the icon plus a full `space-2` step
    // of padding on every side. The previous 26px -- a 5px pad that matched
    // no token -- read as too tight a frame around the glyph.
    width: Theme.icon-md + 2 * Theme.space-2;
    height: self.width;
    // Transparent at rest -- the shared `zoom-group` background (below) is
    // what reads as one element; only the hover highlight belongs to the
    // button itself. Separate boxed buttons either side of a floating
    // readout did not read as one control.
    background: area.has-hover && root.enabled ? Theme.surface-hover : transparent;
    border-radius: Theme.radius-sm;
    opacity: root.enabled ? 1.0 : 0.5;
    accessible-role: button;
    accessible-enabled: root.enabled;

    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.pressed(); }
    }
    Image {
        source: root.icon;
        colorize: area.has-hover && root.enabled ? Theme.text-primary : Theme.text-secondary;
        width: Theme.icon-md;
        height: Theme.icon-md;
    }
}

// The zoom button box is `Theme.icon-md + 2 * Theme.space-2` = 32px square
// (see `FFZoomIconButton`), so the cluster's own height follows it rather
// than a pinned 26px, and everything else in the cluster matches that
// height for one shared baseline. At the bar's right end, mirroring the
// gear's `Theme.space-3` inset at the left: `zoom-group 120 (32+56+32, one
// shared surface) | 16 | Fit 80` -- 120+16+80 = 216. The previous layout
// pinned 200 x 26 (a flat 4 px between every element, each control its own
// box); this instead groups zoom-out/readout/zoom-in into one shared
// rounded surface -- the same track-plus-segments idiom `FFModeSwitch` uses
// (`shell/dock.slint`) -- so they read as one control rather than three
// floating pieces, and keeps `Fit` visually separate with a full
// `Theme.space-4` gap as its own action.
export component FFZoomCluster inherits Rectangle {
    in property <string> readout: "";
    // Whether a project is open, so the readout, the zoom buttons and `Fit`
    // grey out together instead of only the readout going blank -- there is
    // nothing to zoom or fit before a project is loaded.
    in property <bool> project-loaded: false;
    callback zoom-in-requested();
    callback zoom-out-requested();
    callback zoom-fit-requested();

    width: 216px;
    height: zoom-group.height;

    // The shared "track": one rounded surface behind zoom-out, the readout
    // and zoom-in, with no gap between them -- this is what makes the three
    // read as one element. Anonymous (not its own `component`), so
    // `zoom-out`/`zoom-in` keep the qualified ids `FFZoomCluster::zoom-out`
    // / `zoom-in` scoped tests already rely on. Its height follows the icon
    // buttons' own token-derived height, never a repeated literal.
    zoom-group := Rectangle {
        x: 0px;
        y: 0px;
        width: 120px;
        height: zoom-out.height;
        background: Theme.surface-overlay;
        border-radius: Theme.radius-sm;

        zoom-out := FFZoomIconButton {
            x: 0px;
            y: 0px;
            enabled: root.project-loaded;
            icon: @image-url("../../../../assets/icons/zoom-out.svg");
            pressed => { root.zoom-out-requested(); }
        }

        zoom-readout := Text {
            x: zoom-out.x + zoom-out.width;
            y: 0px;
            width: 56px;
            height: zoom-group.height;
            // Dimmed the same way the zoom buttons are: the dash had no
            // opacity of its own, so it would otherwise sit full-strength
            // while its two neighbours were greyed.
            opacity: root.project-loaded ? 1.0 : 0.5;
            // A project-less window has nothing to report a percentage
            // for -- an em dash rather than a blank space, matching the
            // app's own "no binding here" convention for the Input map
            // table, where `crate::input_map::Binding`'s `None` column
            // reads the same way.
            text: root.readout == "" ? "—" : root.readout;
            color: Theme.text-secondary;
            font-size: Theme.text-value.size;
            font-weight: Theme.text-value.weight;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        zoom-in := FFZoomIconButton {
            x: zoom-readout.x + zoom-readout.width;
            y: 0px;
            enabled: root.project-loaded;
            icon: @image-url("../../../../assets/icons/zoom-in.svg");
            pressed => { root.zoom-in-requested(); }
        }
    }

    zoom-fit := Rectangle {
        // A full step of breathing room ahead of `Fit` (`Theme.space-4`),
        // separating it from the zoom group above.
        x: zoom-group.x + zoom-group.width + Theme.space-4;
        y: 0px;
        width: 80px;
        height: zoom-group.height;
        background: fit-area.has-hover && root.project-loaded ? Theme.surface-hover : Theme.surface-overlay;
        border-radius: Theme.radius-sm;
        opacity: root.project-loaded ? 1.0 : 0.5;
        accessible-role: button;
        accessible-enabled: root.project-loaded;

        fit-area := TouchArea {
            enabled: root.project-loaded;
            clicked => { root.zoom-fit-requested(); }
        }
        Text {
            text: "Fit";
            color: Theme.text-primary;
            font-size: Theme.text-body.size;
            font-weight: Theme.text-body.weight;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component FFBottomBar inherits Rectangle {
    callback settings-requested();
    in property <string> zoom-readout: "";
    in property <bool> project-loaded: false;
    callback zoom-in-requested();
    callback zoom-out-requested();
    callback zoom-fit-requested();

    height: ShellGeometry.bottom-bar-height;
    background: Theme.surface-raised;

    gear := TouchArea {
        x: Theme.space-3;
        y: (parent.height - self.height) / 2;
        width: Theme.icon-lg;
        height: Theme.icon-lg;

        clicked => { root.settings-requested(); }

        Image {
            source: @image-url("../../../../assets/icons/settings.svg");
            colorize: gear.has-hover ? Theme.text-primary : Theme.text-secondary;
            width: Theme.icon-md;
            height: Theme.icon-md;
        }
    }

    zoom-cluster := FFZoomCluster {
        x: parent.width - Theme.space-3 - 216px;
        y: (parent.height - self.height) / 2;
        readout: root.zoom-readout;
        project-loaded: root.project-loaded;

        zoom-in-requested => { root.zoom-in-requested(); }
        zoom-out-requested => { root.zoom-out-requested(); }
        zoom-fit-requested => { root.zoom-fit-requested(); }
    }
}
