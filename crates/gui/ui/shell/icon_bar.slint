//
// The left icon bar: the step calculator and Analytics buttons at the top, and
// the notification bell with its unread count above Settings, stacked up from
// the window's bottom edge.

import { Theme } from "../theme.slint";
import { ShellGeometry } from "../geometry.slint";
import { FFIconButton } from "../components/ff_icon_button.slint";
import { FFNavRail } from "../components/ff_nav_rail.slint";

export component FFIconBar inherits Rectangle {
    in property <int> unread: 0;
    // The bell is filled while the center is open.
    in property <bool> center-open: false;
    // The calculator button is drawn selected while its overlay is open.
    in property <bool> calculator-open: false;
    // The Analytics button is drawn selected while its overlay is open.
    in property <bool> analytics-open: false;
    callback calculator-activated();
    callback analytics-activated();
    callback bell-activated();
    callback settings-requested();

    width: ShellGeometry.icon-bar-width;

    FFNavRail {
        width: 100%;
        height: 100%;
        end-aligned: true;
        raised: true;

        bell := FFIconButton {
            icon: root.center-open ? @image-url("../../../../assets/icons/bell-filled.svg")
                : @image-url("../../../../assets/icons/bell.svg");
            focusable: true;
            filled: root.center-open;
            badge: root.unread;
            accessible-label: "Notifications";
            triggered => { root.bell-activated(); }
        }
        settings := FFIconButton {
            icon: @image-url("../../../../assets/icons/settings.svg");
            focusable: true;
            accessible-label: "Settings";
            triggered => { root.settings-requested(); }
        }
    }

    // Declared after the rail so its ground does not paint over the button.
    FFIconButton {
        x: Theme.space-2;
        y: Theme.space-2;
        icon: @image-url("../../../../assets/icons/calculator.svg");
        focusable: true;
        current: root.calculator-open;
        accessible-label: "Step calculator";
        triggered => { root.calculator-activated(); }
    }
    FFIconButton {
        x: Theme.space-2;
        y: Theme.space-2 + ShellGeometry.icon-bar-slot-height;
        icon: @image-url("../../../../assets/icons/chart-bar.svg");
        focusable: true;
        current: root.analytics-open;
        accessible-label: "Analytics";
        triggered => { root.analytics-activated(); }
    }
}
