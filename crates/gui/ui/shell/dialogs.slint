// SPDX-License-Identifier: GPL-3.0-or-later
//
// The one grouping question and the two refusals the entry path can
// produce. Modelled on `ui/shell/settings_modal.slint`.
// No string in this file, or anywhere else under `ui/`, contains `group` --
// "stacks" and "projects" carry the same meaning without inventing
// vocabulary the CLI has no counterpart for.

import { Theme } from "../theme.slint";
import { FFDialog } from "../components/ff_dialog.slint";

export component FFGroupingQuestion inherits Rectangle {
    in property <bool> question-open: false;
    in property <int> frame-count: 0;
    in property <int> project-count: 0;
    callback open-as-one();
    callback open-as-many();
    callback cancelled();

    visible: root.question-open;

    scrim := Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface-canvas.with-alpha(0.6);

        TouchArea {
            width: 100%;
            height: 100%;
            scroll-event(e) => { accept }
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 480px;
        height: 200px;
        background: Theme.surface-raised;
        border-radius: Theme.radius-lg;

        VerticalLayout {
            padding: Theme.space-4;
            spacing: Theme.space-3;

            body := Text {
                text: "This folder reads as " + root.project-count + " stacks of "
                    + root.frame-count + " frames.";
                color: Theme.text-primary;
                font-size: Theme.text-body.size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Theme.space-2;

                one-button := Rectangle {
                    height: 36px;
                    background: Theme.accent-default;
                    border-radius: Theme.radius-sm;
                    TouchArea { clicked => { root.open-as-one(); } }
                    Text {
                        text: "Open as one project";
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
                many-button := Rectangle {
                    height: 36px;
                    background: Theme.surface-hover;
                    border-radius: Theme.radius-sm;
                    TouchArea { clicked => { root.open-as-many(); } }
                    Text {
                        text: "Open as " + root.project-count + " projects";
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }

            cancel-area := TouchArea {
                height: 24px;
                clicked => { root.cancelled(); }
                Text {
                    text: "Cancel";
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

export component FFRefusalDialog inherits Rectangle {
    in property <bool> refusal-open: false;
    in property <string> title: "No frames here";
    in property <string> body: "FocusForge reads 16-bit TIFF (.tif, .tiff). This folder holds none.";
    in property <string> button-label: "Pick another folder…";
    callback pick-another-folder();

    visible: root.refusal-open;

    scrim := Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface-canvas.with-alpha(0.6);

        TouchArea {
            width: 100%;
            height: 100%;
            scroll-event(e) => { accept }
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: 180px;
        background: Theme.surface-raised;
        border-radius: Theme.radius-lg;

        VerticalLayout {
            padding: Theme.space-4;
            spacing: Theme.space-3;

            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: Theme.text-title.size;
                font-weight: Theme.text-title.weight;
            }
            Text {
                text: root.body;
                color: Theme.text-secondary;
                font-size: Theme.text-body.size;
                wrap: word-wrap;
            }
            pick-area := Rectangle {
                height: 36px;
                background: Theme.accent-default;
                border-radius: Theme.radius-sm;
                TouchArea { clicked => { root.pick-another-folder(); } }
                Text {
                    text: root.button-label;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }
    }
}

// A non-modal notice over the canvas: no scrim, self-timing (auto-dismisses
// after six seconds) and also dismissed early by its own `x`. Either way,
// dismissal carries no side effect beyond closing the notice -- there is
// nothing here to mark reported.
export component FFToast inherits Rectangle {
    in property <bool> toast-open: false;
    in property <string> message: "";
    // "failure" (default): a run's own toast. "info": a plain notice, such
    // as a folder open that skipped some of what it found.
    in property <string> tone: "failure";
    // A second, optional line below the message; hidden when empty.
    in property <string> link-label: "";
    callback dismissed();
    callback link-activated();

    width: 300px;
    height: 84px;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border-default;
    border-radius: Theme.radius-lg;
    opacity: root.toast-open ? 1.0 : 0.0;
    animate opacity { duration: Theme.motion-slow; easing: ease-out; }

    icon := Image {
        x: Theme.space-4;
        y: Theme.space-4;
        source: root.tone == "failure" ? @image-url("../../../../assets/icons/triangle-alert.svg")
            : @image-url("../../../../assets/icons/info.svg");
        colorize: root.tone == "failure" ? Theme.status-failure : Theme.text-secondary;
        width: 18px;
        height: 18px;
    }

    title := Text {
        x: icon.x + icon.width + Theme.space-2;
        y: icon.y;
        width: parent.width - self.x - Theme.space-3;
        height: 32px;
        text: root.message;
        color: Theme.text-primary;
        font-size: Theme.text-title.size;
        font-weight: Theme.text-title.weight;
        wrap: word-wrap;
        overflow: clip;
    }

    if root.link-label != "": link-area := TouchArea {
        x: title.x;
        y: title.y + title.height;
        accessible-role: button;
        clicked => { root.link-activated(); }

        Text {
            text: root.link-label;
            color: Theme.accent-default;
            font-size: Theme.text-body.size;
        }
    }

    dismiss-area := TouchArea {
        x: parent.width - Theme.space-3 - 12px;
        y: Theme.space-3;
        width: 12px;
        height: 12px;
        enabled: root.toast-open;
        clicked => { root.dismissed(); }
        Image {
            source: @image-url("../../../../assets/icons/x.svg");
            colorize: Theme.text-secondary;
            width: 12px;
            height: 12px;
        }
    }
}

// The one warning a frame-set change (add/reorder/remove) shows once its
// project already carries a checkpoint -- `AppController::pending_frame_change`
// supplies every string and flag below, already rendered.
export component FFFrameSetWarning inherits FFDialog {
    tone: "warning";
    confirm-kind: "primary";
}

// Asked after a run whose alignment left some frames unregistered, before
// its checkpoint is committed; the body names those frames.
export component FFDivergenceWarning inherits FFDialog {
    tone: "warning";
    title: "Keep this fused result?";
    cancel-label: "Discard";
    confirm-label: "Keep";
    confirm-kind: "primary";
}

// Asked before closing a tab, or the window, with checkpoints no project
// file contains; `AppController::pending_close` supplies the close-a-tab
// title, context, body and info, `pending_quit_copy` the quit-the-window
// ones, whichever is pending.
export component FFCloseGuard inherits FFDialog {
    tone: "save";
    confirm-kind: "danger";
}

// A saved project's source content no longer matches the fingerprint it
// was recorded with, blocking the open until a choice is made;
// `AppController::mismatch_copy` supplies the context and body. `Open
// anyway` is a `status.failure`-styled (`confirm-kind: "danger"`) confirm,
// as `FFCloseGuard`'s own is.
export component FFFingerprintMismatch inherits FFDialog {
    tone: "warning";
    panel-width: 600px;
    panel-height: 362px;
    title: "The source frames are not the same";
    info: "Finding the original frames again opens the project unchanged.";
    secondary-label: "Locate frames…";
    confirm-label: "Open anyway";
    confirm-kind: "danger";
}

// An opened project's sources cannot all be resolved from here;
// `AppController::sources_notice` supplies the context and body. The
// project is already open, so its dismiss is `Close`, not `Cancel`.
export component FFSourcesMissing inherits FFDialog {
    tone: "caution";
    panel-width: 540px;
    panel-height: 330px;
    title: "The frames are no longer there";
    info: "The Projects overlay shows the same condition as a \"Sources missing\" card.";
    cancel-label: "Close";
    confirm-label: "Locate frames…";
    confirm-kind: "default";
}
