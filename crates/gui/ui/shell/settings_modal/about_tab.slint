// SPDX-License-Identifier: GPL-3.0-or-later
//
// The About section's content: the build's version, the licence, the update
// controls, the licence notice and the source location.

import { Theme } from "../../theme.slint";
import { ShellGeometry } from "../../geometry.slint";
import { FFButton } from "../../components/ff_button.slint";
import { FFErrorRow } from "../../components/ff_error_row.slint";
import { FFLinkText } from "../../components/ff_link_text.slint";
import { FFRowText } from "../../components/ff_row_text.slint";
import { FFScrollbar } from "../../components/ff_scrollbar.slint";
import { FFSettingsActionRow } from "../../components/ff_settings_action_row.slint";
import { FFSettingsRow } from "../../components/ff_settings_row.slint";
import { FFSettingsSection } from "../../components/ff_settings_section.slint";
import { FFToggle } from "../../components/ff_toggle.slint";

export struct AboutState {
    version: string,
    source: string,
}

export struct UpdateControlsState {
    check-on-start: bool,
    check-enabled: bool,
    checking: bool,
    status: string,
    // "none" | "success" | "warning" | "failure".
    status-tone: string,
    // The newer version's line; empty without one.
    result-text: string,
    skip-enabled: bool,
    // The failed check's line; empty without one.
    failure: string,
    // The write error of the last save; empty without one.
    save-error: string,
}

export component FFAboutTab inherits Rectangle {
    in property <AboutState> about;
    in property <UpdateControlsState> update-controls;
    callback check-on-start-toggled(bool);
    callback check-now-requested();
    callback skip-requested();
    callback page-requested();

    scroller := Flickable {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding-left: ShellGeometry.settings-content-inset-left;
            padding-right: ShellGeometry.settings-content-inset-right;
            padding-top: ShellGeometry.settings-content-inset-top;
            padding-bottom: ShellGeometry.settings-content-inset-bottom;
            spacing: ShellGeometry.settings-section-gap;
            alignment: start;

            FFSettingsSection {
                heading: "FOCUSFORGE";

                FFSettingsRow {
                    label: "Version";
                    FFRowText { text: root.about.version; }
                }
                FFSettingsRow {
                    label: "License";
                    FFRowText { text: "GPL-3.0"; }
                }
            }

            FFSettingsSection {
                heading: "UPDATES";

                FFSettingsRow {
                    label: "Check for updates at start";
                    align-end: true;
                    wide-label: true;

                    FFToggle {
                        name: "Check for updates at start";
                        on: root.update-controls.check-on-start;
                        toggled => { root.check-on-start-toggled(!root.update-controls.check-on-start); }
                    }
                }

                FFSettingsActionRow {
                    button-text: "Check now";
                    enabled: root.update-controls.check-enabled;
                    busy: root.update-controls.checking;
                    status-text: root.update-controls.status;
                    status-tone: root.update-controls.status-tone;
                    clicked => { root.check-now-requested(); }
                }

                if root.update-controls.result-text != "": Rectangle {
                    height: 2 * ShellGeometry.settings-row-height - Theme.space-2;

                    FFRowText {
                        x: ShellGeometry.settings-label-width;
                        y: 0px;
                        width: parent.width - self.x;
                        height: ShellGeometry.settings-row-height - Theme.space-1;
                        text: root.update-controls.result-text;
                    }
                    FFLinkText {
                        x: ShellGeometry.settings-label-width;
                        y: ShellGeometry.settings-row-height - Theme.space-1 + (ShellGeometry.toolbar-button-height - self.height) / 2;
                        width: self.preferred-width;
                        height: self.preferred-height;
                        text: "Open download page";
                        activated => { root.page-requested(); }
                    }
                    FFButton {
                        x: parent.width - self.width;
                        y: ShellGeometry.settings-row-height - Theme.space-1;
                        width: ShellGeometry.settings-action-button-width;
                        compact: true;
                        text: "Skip this version";
                        enabled: root.update-controls.skip-enabled;
                        clicked => { root.skip-requested(); }
                    }
                }

                if root.update-controls.failure != "": Rectangle {
                    height: ShellGeometry.settings-row-height;

                    FFErrorRow {
                        x: ShellGeometry.settings-label-width;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - self.x;
                        message: root.update-controls.failure;
                        show-icon: true;
                        wrap-message: true;
                    }
                }

                if root.update-controls.save-error != "": VerticalLayout {
                    spacing: Theme.space-2;
                    padding-top: Theme.space-2;

                    FFErrorRow {
                        message: root.update-controls.save-error;
                        show-icon: true;
                        wrap-message: true;
                    }
                    FFRowText {
                        text: "The change is active for this session.";
                        vertical-alignment: top;
                    }
                }
            }

            FFSettingsSection {
                heading: "NOTICE";

                VerticalLayout {
                    spacing: ShellGeometry.settings-paragraph-gap;

                    FFRowText { text: "Copyright © 2026 Johannes Sood"; wrap: word-wrap; }
                    FFRowText {
                        text: "FocusForge is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 3 of the License.";
                        wrap: word-wrap;
                    }
                    FFRowText {
                        text: "This program comes with ABSOLUTELY NO WARRANTY. See the LICENSE file for the full license text.";
                        wrap: word-wrap;
                    }
                    FFSettingsRow {
                        label: "Source";
                        divider: false;
                        FFRowText { text: root.about.source; accent: true; }
                    }
                }
            }
        }
    }

    FFScrollbar {
        x: parent.width - self.width - Theme.space-2;
        height: parent.height;
        content-height: scroller.viewport-height;
        viewport-height: scroller.height;
        offset: -scroller.viewport-y;
    }
}
