//
// The Input map section's content: the read-only three-column table and its
// provenance line.

import { Theme } from "../../theme.slint";

export struct InputRow {
    input: string,
    stacking: string,
    editor: string,
}

component FFInputTableRow inherits Rectangle {
    in property <string> input-label: "";
    in property <string> stacking-label: "";
    in property <string> editor-label: "";
    in property <bool> header: false;

    min-height: 32px;

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;
        spacing: Theme.space-2;

        // The content column is too narrow for the widest input combo and
        // action name on one line each. Text wraps rather than elides, and
        // `min-height` above lets the row grow to two lines.
        Text {
            text: root.input-label;
            color: root.header ? Theme.text-muted : Theme.text-primary;
            font-size: Theme.text-body.size;
            font-weight: root.header ? Theme.text-section.weight : Theme.text-body.weight;
            width: 42%;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        Text {
            text: root.stacking-label;
            color: root.header ? Theme.text-muted : Theme.text-secondary;
            font-size: Theme.text-body.size;
            font-weight: root.header ? Theme.text-section.weight : Theme.text-body.weight;
            width: 29%;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        Text {
            text: root.editor-label;
            color: root.header ? Theme.text-muted : Theme.text-secondary;
            font-size: Theme.text-body.size;
            font-weight: root.header ? Theme.text-section.weight : Theme.text-body.weight;
            width: 29%;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

export component FFInputMapTab inherits Rectangle {
    in property <[InputRow]> input-rows: [];
    in property <string> input-provenance: "";

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-2;

        Text {
            text: "Input map";
            color: Theme.text-primary;
            font-size: Theme.text-title.size;
            font-weight: Theme.text-title.weight;
        }

        provenance := Text {
            text: root.input-provenance;
            color: Theme.text-muted;
            font-size: Theme.text-body.size;
        }

        FFInputTableRow {
            header: true;
            input-label: "Input";
            stacking-label: "Stacking";
            editor-label: "Editor";
        }

        for row[i] in root.input-rows: FFInputTableRow {
            input-label: row.input;
            stacking-label: row.stacking;
            editor-label: row.editor;
        }
    }
}
