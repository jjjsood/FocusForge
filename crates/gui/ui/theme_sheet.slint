            width: 320px;
            label-text: "Target (stops)";
            FFSlider { scale: "linear"; fraction: 1.0; value-text: "+0.5"; }
        }
        FFRowLabel {
            width: 320px;
            label-text: "Target (stops, disabled)";
            disabled: true;
            FFSlider { scale: "linear"; fraction: 0.3; value-text: "\u{2212}0.2"; disabled: true; }
        }

        GroupHeading { text: "Settings panel: field states"; }
        HorizontalLayout {
            spacing: Theme.space-3;
            FFField { width: 90px; text: "4"; }
            FFField { width: 90px; text: "4"; hovered: true; }
            FFField { width: 90px; text: "4"; focused: true; }
            FFField { width: 90px; text: "4"; disabled: true; }
            FFField { width: 90px; text: "4"; invalid: true; }
        }

        GroupHeading { text: "Settings panel: toggle"; }
        HorizontalLayout {
            spacing: Theme.space-4;
            FFToggle { on: true; }
            FFToggle { on: false; }
            FFToggle { on: true; disabled: true; }
        }

        GroupHeading { text: "Settings panel: picker (closed)"; }
        FFMenu {
            width: 220px;
            label: "Option A";
            choices: ["Option A", "Option B"];
            choice-ids: ["option-a", "option-b"];
            selected: "option-a";
        }

        GroupHeading { text: "Settings panel: picker (open)"; }
        Rectangle {
            width: 220px;
            height: 120px;
            FFMenu {
                width: 220px;
                label: "Option A";
                choices: ["Option A", "Option B"];
                choice-ids: ["option-a", "option-b"];
                selected: "option-a";
                open: true;
            }
        }

        GroupHeading { text: "Settings panel: bool row + error row"; }
        HorizontalLayout {
            width: 320px;
            alignment: space-between;
            FFRowText { text: "Auto-crop"; }
            FFToggle { on: true; }
        }
        FFErrorRow { width: 320px; message: "epsilon-px: out of range"; }

        GroupHeading { text: "Settings panel: more fold-out"; }
        HorizontalLayout {
            spacing: Theme.space-3;
            for state in ["default", "hover", "focus", "disabled"]: VerticalLayout {
                width: 260px;
                spacing: Theme.space-3;
                FFMoreToggle {
                    height: ShellGeometry.more-height;
                    hovered: state == "hover";
                    focused: state == "focus";
                    disabled: state == "disabled";
                }
                FFMoreToggle {
                    open: true;
                    height: ShellGeometry.more-height + ShellGeometry.more-gap + ShellGeometry.param-label-height + ShellGeometry.param-row-linear;
                    hovered: state == "hover";
                    focused: state == "focus";
                    disabled: state == "disabled";
                    FFRowLabel {
                        x: ShellGeometry.dock-content-inset;
                        y: ShellGeometry.more-height + ShellGeometry.more-gap;
                        width: ShellGeometry.panel-content-width;
                        label-text: "Levels";
                        FFSlider {
                            scale: "linear";
                            fraction: 0.4;
                            value-text: "5";
                            recessed: true;
                            disabled: state == "disabled";
                        }
                    }
                }
            }
        }

        GroupHeading { text: "Settings panel: scrollbar + reset-all"; }
        HorizontalLayout {
            spacing: Theme.space-6;
            FFScrollbar { height: 80px; content-height: 400px; viewport-height: 80px; offset: 40px; }
            FFResetAll { width: 220px; enabled: true; }
            FFResetAll { width: 220px; enabled: false; }
        }

        GroupHeading { text: "Toolbar: transport button"; }
        HorizontalLayout {
            spacing: Theme.space-3;
            FFButton { width: 116px; compact: true; kind: "primary"; glyph: "▶"; text: "Fuse stack"; }
            FFButton { width: 116px; compact: true; kind: "default"; glyph: "⏸"; text: "Pause"; }
            FFButton { width: 116px; compact: true; kind: "default"; glyph: "▶"; text: "Resume"; }
            FFButton { width: 116px; compact: true; kind: "default"; glyph: "☐"; text: "Cancel"; }
            FFButton { width: 116px; compact: true; kind: "quiet"; glyph: "☐"; text: "Cancelling…"; enabled: false; }
            FFButton { width: 116px; compact: true; kind: "primary"; glyph: "↻"; text: "Retry"; }
            FFButton { width: 116px; compact: true; kind: "default"; text: "Fuse stack"; enabled: false; }
            FFButton {
                width: 140px;
                kind: "primary";
                has-icon: true;
                icon-source: @image-url("../../../assets/icons/download.svg");
                text: "Create bundle";
            }
        }

        GroupHeading { text: "Bottom bar: progress track"; }
        VerticalLayout {
            spacing: Theme.space-2;
            FFProgressBar { width: 400px; tone: "running"; fraction: 0.62; }
            FFProgressBar { width: 400px; tone: "held"; fraction: 0.62; }
            FFProgressBar { width: 400px; tone: "failed"; fraction: 0.24; }
            FFProgressBar { width: 400px; tone: "running"; fraction: 0.0; }
            FFProgressBar { width: 400px; tone: "running"; indeterminate: true; }
        }

        GroupHeading { text: "Loading indicator"; }
        HorizontalLayout {
            spacing: Theme.space-4;
            FFSpinner {}
            FFLoadingPanel { caption: "Loading…"; }
        }

        GroupHeading { text: "Canvas: pane placeholder"; }
        FFPanePlaceholder { }

        GroupHeading { text: "Checkpoints list: row"; }
        VerticalLayout {
            spacing: 0px;
            FFSectionHeading {
                width: ShellGeometry.dock-width - 2 * ShellGeometry.dock-content-inset;
                label: "TODAY";
                compact: true;
                opaque: false;
            }
            FFCheckpointRow {
                algorithm: "Laplacian Pyramid";
                time-text: "16:42:08";
                selected: true;
            }
            FFCheckpointRow {
                algorithm: "dwt-wavelet";
                time-text: "15:58:30";
                deletable: true;
                hovered: true;
            }
            FFCheckpointRow {
                algorithm: "dwt-wavelet";
                time-text: "15:12:44";
                deletable: true;
            }
            FFSectionHeading {
                width: ShellGeometry.dock-width - 2 * ShellGeometry.dock-content-inset;
                label: "YESTERDAY";
                compact: true;
                opaque: false;
            }
            FFCheckpointRow {
                algorithm: "Laplacian Pyramid";
                time-text: "21:08:12";
            }
        }

        GroupHeading { text: "Checkpoints list: fresh row, tint at its peak"; }
        VerticalLayout {
            spacing: 0px;
            FFCheckpointRow {
                algorithm: "Laplacian Pyramid";
                time-text: "16:43:01";
                selected: true;
                flash-held: true;
            }
            FFCheckpointRow {
                algorithm: "dwt-wavelet";
                time-text: "15:58:30";
                deletable: true;
            }
        }

        GroupHeading { text: "Checkpoints list: last row, hovered"; }
        FFCheckpointRow {
            algorithm: "Laplacian Pyramid";
            time-text: "16:42:08";
            selected: true;
            hovered: true;
            deletable: false;
        }

        GroupHeading { text: "Images list: legend row"; }
        VerticalLayout {
            spacing: 0px;
            FFImageRow {
                width: 248px;
                legend: true;
                mutable: false;
                chip: Theme.status-failure;
                name: "IMG_9811";
                time-text: "1";
            }
            FFImageRow {
                width: 248px;
                legend: true;
                mutable: false;
                chip: Theme.status-warning;
                name: "IMG_9812";
                time-text: "2";
                hovered: true;
            }
            FFImageRow {
                width: 248px;
                legend: true;
                mutable: false;
                chip: Theme.accent-default;
                name: "IMG_9815";
                time-text: "";
                unresolved: true;
            }
            FFImageRow {
                width: 248px;
                legend: true;
                mutable: false;
                chip: Theme.status-success;
                name: "IMG_9816";
                time-text: "6";
                selected: true;
            }
        }

        Rectangle {
            width: 200px;
            height: 48px;
            FFMenuList {
                width: 200px;
                choices: ["Name", "Capture time"];
                choice-ids: ["name", "capture-time"];
                show-choice-ids: false;
                selected: "name";
            }
        }

        GroupHeading { text: "Dialog footer"; }
        FFDialogFooter {
            width: 480px;
            secondary-label: "New project instead";
            confirm-label: "Add and re-fuse";
        }

        GroupHeading { text: "Dialog footer: renamed cancel button"; }
        FFDialogFooter {
            width: 480px;
            cancel-label: "Discard";
            confirm-label: "Keep";
        }

        GroupHeading { text: "Dialog: warning, with a secondary button"; }
        Rectangle {
            width: 500px;
            height: 320px;
            clip: true;
            FFDialog {
                width: 100%;
                height: 100%;
                open: true;
                tone: "warning";
                title: "Add 3 frames and fuse again?";
                body: "This project already holds 2 checkpoints, and confirming keeps every one of them.";
                info: "Or start a new project with the same settings instead.";
                secondary-label: "New project instead";
                confirm-label: "Add and re-fuse";
            }
        }

        GroupHeading { text: "Dialog: warning, Remove's own footer"; }
        Rectangle {
            width: 500px;
            height: 320px;
            clip: true;
            FFDialog {
                width: 100%;
                height: 100%;
                open: true;
                tone: "warning";
                title: "Remove and fuse again?";
                body: "This project already holds 2 checkpoints, and confirming keeps every one of them.";
                info: "You can also start a new project with the same settings instead.";
                secondary-label: "Exclude instead";
                confirm-label: "Remove and re-fuse";
            }
        }

        GroupHeading { text: "Dialog: caution"; }
        Rectangle {
            width: 560px;
            height: 350px;
            clip: true;
            FFDialog {
                width: 100%;
                height: 100%;
                open: true;
                tone: "caution";
                panel-width: 540px;
                panel-height: 330px;
                title: "The frames are no longer there";
                context: "demo.ffp";
                body: "A project remembers its frames by path. 2 of 3 cannot be found in this location.\n\nHistory and Z-Map are complete. Fused results still show; edited checkpoints and re-fusing need the frames.";
                info: "The Projects overlay shows the same condition as a \"Sources missing\" card.";
                cancel-label: "Close";
                confirm-label: "Locate frames…";
                confirm-kind: "default";
            }
        }

        GroupHeading { text: "Dialog: warning, danger confirm (600×362)"; }
        Rectangle {
            width: 620px;
            height: 382px;
            clip: true;
            FFDialog {
                width: 100%;
                height: 100%;
                open: true;
                tone: "warning";
                panel-width: 600px;
                panel-height: 362px;
                title: "The source frames are not the same";
                context: "demo.ffp";
                body: "The project was made over 3 frames. The frames in this location give a different fingerprint.\n\nThe Z-Map records, for every pixel, which frame it came from — by that frame's place in the row. If the row is wrong, every retouch points at the wrong frame.";
                info: "Finding the original frames again opens the project unchanged.";
                secondary-label: "Locate frames…";
                confirm-label: "Open anyway";
                confirm-kind: "danger";
            }
        }

        GroupHeading { text: "Dialog: delete a checkpoint"; }
        Rectangle {
            width: 580px;
            height: 336px;
            clip: true;
            FFCheckpointDelete {
                width: 100%;
                height: 100%;
                open: true;
                context: "Laplacian Pyramid · 15:47:02";
                body: "The other 3 checkpoints are untouched, and the stack is not fused again.";
            }
        }

        GroupHeading { text: "Dialog: save, with a context line"; }
        Rectangle {
            width: 500px;
            height: 320px;
            clip: true;
            FFDialog {
                width: 100%;
                height: 100%;
                open: true;
                tone: "save";
                title: "Save this state first?";
                context: "Closing IMG_9801-9861";
                body: "2 checkpoints have been fused since the last save. They belong to no saved project.\n\nClosing without saving loses them.";
                info: "Saving adds them to IMG_9801-9861.ffp.";
                secondary-label: "Save and close";
                confirm-label: "Close without saving";
                confirm-kind: "danger";
            }
        }

        GroupHeading { text: "Dialog: header status glyph"; }
        HorizontalLayout {
            spacing: Theme.space-4;
            FFStatusGlyph { kind: "swatch"; }
            FFStatusGlyph { kind: "circle"; }
        }

        GroupHeading { text: "Dialog: heading"; }
        VerticalLayout {
            spacing: Theme.space-2;
            FFHeading { text: "Export image"; }
            FFHeading { text: "Can't export this position"; tone: "failure"; size: "body"; }
        }

        GroupHeading { text: "Dialog: divider"; }
        FFDivider { width: 300px; }

        GroupHeading { text: "Dialog: segmented selector"; }
        FFSegmented { width: 168px; segments: ["TIFF", "JPEG"]; selected: "TIFF"; }

        GroupHeading { text: "Projects overlay: chip"; }
        HorizontalLayout {
            spacing: Theme.space-4;
            FFChip { text: "UNSAVED"; tone: "accent"; }
            FFChip { text: "CURRENT"; tone: "accent"; }
            FFChip { text: "MUTED"; tone: "muted"; }
        }

        GroupHeading { text: "Projects overlay: outlined button"; }
        HorizontalLayout {
            spacing: Theme.space-4;
            FFButton { width: 130px; height: 30px; kind: "outlined"; text: "Run again"; }
            FFButton { width: 130px; height: 30px; kind: "outlined"; text: "Locate frames…"; }
        }

        GroupHeading { text: "Projects overlay: card, every kind"; }
        HorizontalLayout {
            spacing: Theme.space-6;
            FFProjectCard {
                kind: "open";
                opened: true;
                current: true;
                unsaved: true;
                project-name: "IMG_9801-9861";
                meta-text: "61 frames · 4 checkpoints";
            }
            FFProjectCard {
                kind: "open";
                opened: true;
                fusing: true;
                fusing-fraction: 0.42;
                project-name: "IMG_9941-9977";
                meta-text: "37 frames · aligning, 15 of 37";
            }
            FFProjectCard {
                kind: "failed";
                opened: true;
                current: true;
                glyph: @image-url("../../../assets/icons/triangle-alert.svg");
                headline: "Did not stack";
                stage: "FAILED WHILE ALIGNING";
                reason: "Frames 12 and 13 share no overlap. Alignment stopped there.";
                action-label: "Run again";
                project-name: "IMG_9862-9903";
                meta-text: "42 frames · 1 checkpoint";
            }
        }
        HorizontalLayout {
            spacing: Theme.space-6;
            FFProjectCard {
                kind: "sources-missing";
                opened: true;
                unsaved: true;
                glyph: @image-url("../../../assets/icons/circle-alert.svg");
                headline: "Sources missing";
                stage: "NOTHING TO SHOW";
                reason: "The project points at frames that are not where it left them.";
                action-label: "Locate frames…";
                project-name: "IMG_9978-9994";
                meta-text: "17 frames · 3 checkpoints";
            }
            FFProjectCard {
                kind: "cancelled";
                opened: true;
                glyph: @image-url("../../../assets/icons/x.svg");
                headline: "Cancelled";
                stage: "STOPPED WHILE FUSING";
                reason: "You stopped this one. Nothing was written.";
                action-label: "Run again";
                project-name: "IMG_10062-10090";
                meta-text: "29 frames · 2 checkpoints";
            }
            FFProjectCard {
                kind: "not-a-project";
                glyph: @image-url("../../../assets/icons/folder.svg");
                headline: "Not a project";
                stage: "LEFT ALONE";
                reason: "This folder holds something else. Nothing was read and nothing was changed.";
                action-label: "";
                project-name: "contact-sheets";
                meta-text: "not read · not changed";
            }
        }
    }
    }
}
