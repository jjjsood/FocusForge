// SPDX-License-Identifier: GPL-3.0-or-later
//
// Visual reference sheet for every design token and shared component,
// rendered via `--theme-sheet`. Kept separate from `theme.slint`: a test
// there forbids the substring `width` anywhere in that file, and a swatch
// needs one.

import { Theme, TypeRole } from "theme.slint";
import { ShellGeometry } from "geometry.slint";
import { FFIconButton } from "components/ff_icon_button.slint";
import { FFSlider } from "components/ff_slider.slint";
import { FFField } from "components/ff_field.slint";
import { FFToggle } from "components/ff_toggle.slint";
import { FFMenu } from "components/ff_menu.slint";
import { FFMenuList } from "components/ff_menu_list.slint";
import { FFSectionHeading } from "components/ff_section_heading.slint";
import { FFErrorRow } from "components/ff_error_row.slint";
import { FFScrollbar } from "components/ff_scrollbar.slint";
import { FFResetAll } from "components/ff_reset_all.slint";
import { FFMoreToggle } from "components/ff_more_toggle.slint";
import { FFRowLabel } from "components/ff_row_label.slint";
import { FFRowText } from "components/ff_row_text.slint";
import { FFButton } from "components/ff_button.slint";
import { FFProgressBar } from "components/ff_progress_bar.slint";
import { FFPanePlaceholder } from "components/ff_pane_placeholder.slint";
import { FFSpinner } from "components/ff_spinner.slint";
import { FFLoadingPanel } from "components/ff_loading_panel.slint";
import { FFImageRow } from "components/ff_image_row.slint";
import { FFTooltip } from "components/ff_tooltip.slint";
import { FFDragLandingMarker } from "components/ff_drag_landing_marker.slint";
import { FFCheckpointRow } from "components/ff_checkpoint_row.slint";
import { FFDialog } from "components/ff_dialog.slint";
import { FFDialogFooter } from "components/ff_dialog_footer.slint";
import { FFChip } from "components/ff_chip.slint";
import { FFProjectCard } from "components/ff_project_card.slint";
import { FFManifestList } from "components/ff_manifest_list.slint";
import { FFBrushCursor } from "components/ff_brush_cursor.slint";
import { FFStatusGlyph } from "components/ff_status_glyph.slint";
import { FFHeading } from "components/ff_heading.slint";
import { FFDivider } from "components/ff_divider.slint";
import { FFSegmented } from "components/ff_segmented.slint";
import { FFPane } from "components/ff_pane.slint";
import { FFPaneLabel } from "components/ff_pane_label.slint";
import { FFUndockControl } from "components/ff_undock_control.slint";
import { FFWindowBar } from "components/ff_window_bar.slint";
import { FFCheckpointDelete } from "shell/dialogs.slint";
import { FFNotificationGlyph } from "components/ff_notification_glyph.slint";
import { FFToast } from "components/ff_toast.slint";
import { FFNotificationRow } from "components/ff_notification_row.slint";
import { FFModalPanel } from "components/ff_modal_panel.slint";
import { FFTextField } from "components/ff_text_field.slint";
import { FFNavRail } from "components/ff_nav_rail.slint";
import { FFNavRailEntry } from "components/ff_nav_rail_entry.slint";
import { FFSettingsSection } from "components/ff_settings_section.slint";
import { FFSettingsRow } from "components/ff_settings_row.slint";
import { FFSettingsPathRow } from "components/ff_settings_path_row.slint";
import { FFSettingsActionRow } from "components/ff_settings_action_row.slint";
import { FFStatusText } from "components/ff_status_text.slint";
import { FFInputTableRow } from "components/ff_input_table_row.slint";

// The settings modal's own ground, content width plus its padding.
component SettingsGround inherits Rectangle {
    width: ShellGeometry.settings-content-width + 2 * Theme.space-4;
    height: lay.preferred-height;
    background: Theme.surface-raised;

    lay := VerticalLayout {
        padding: Theme.space-4;
        alignment: start;
        @children
    }
}

// The notification center's own ground: its width over the raised fill,
// rows stacked from the top.
component CenterGround inherits Rectangle {
    width: ShellGeometry.notification-center-width;
    background: Theme.surface-raised;
    clip: true;

    VerticalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        alignment: start;
        @children
    }
}

// A text field in a settings row's value slot. The slot keeps the field's
// unemphasised size, so its focus growth stays centred.
component CapFieldSlot inherits Rectangle {
    in property <string> text: "";
    in property <string> placeholder: "";
    in property <string> tone: "neutral";
    in property <bool> enabled: true;
    width: ShellGeometry.settings-field-width;
    height: ShellGeometry.field-height;

    FFTextField {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.text;
        placeholder: root.placeholder;
        tone: root.tone;
        enabled: root.enabled;
        field-width: parent.width;
    }
}

component ColourSwatch inherits Rectangle {
    in property <color> swatch;
    in property <string> label;
    width: 210px;
    height: 32px;

    HorizontalLayout {
        spacing: Theme.space-2;
        Rectangle {
            width: 24px;
            height: 24px;
            background: root.swatch;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-default;
        }
        Text {
            text: root.label;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
}

component GroupHeading inherits Text {
    color: Theme.text-secondary;
    font-weight: 600;
}

component TypeSample inherits Rectangle {
    in property <TypeRole> role;
    in property <string> label;
    height: 24px;

    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: root.role.size;
        font-weight: root.role.weight;
        letter-spacing: root.role.letter-spacing;
    }
}

component SpacingSample inherits Rectangle {
    in property <length> step;
    in property <string> label;
    height: 24px;

    HorizontalLayout {
        spacing: Theme.space-2;
        Rectangle {
            width: root.step;
            height: 16px;
            background: Theme.accent-default;
        }
        Text { text: root.label; color: Theme.text-primary; vertical-alignment: center; }
    }
}

component RadiusSample inherits Rectangle {
    in property <length> corner;
    in property <string> label;
    height: 24px;

    HorizontalLayout {
        spacing: Theme.space-2;
        Rectangle {
            width: 32px;
            height: 24px;
            background: Theme.surface-overlay;
            border-radius: root.corner;
        }
        Text { text: root.label; color: Theme.text-primary; vertical-alignment: center; }
    }
}

component IconSizeSample inherits Rectangle {
    in property <length> icon-size;
    in property <string> label;
    height: 24px;

    HorizontalLayout {
        spacing: Theme.space-2;
        Rectangle {
            width: root.icon-size;
            height: root.icon-size;
            background: Theme.text-primary;
        }
        Text { text: root.label; color: Theme.text-primary; vertical-alignment: center; }
    }
}

export component ThemeSheet inherits Window {
    title: "FocusForge -- token sheet";
    preferred-width: 1100px;
    preferred-height: 1000px;
    background: Theme.surface-base;
    default-font-family: Theme.font-family;

    Flickable {
        width: root.width;
        height: root.height;

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;
        alignment: start;

        GroupHeading { text: "FFToast: info, warning, failure / crash, hover, focus"; }
        VerticalLayout {
            spacing: Theme.space-4;
            HorizontalLayout {
                spacing: Theme.space-6;
                alignment: start;
                FFToast { toast-open: true; kind: "info"; title: "Some images were skipped"; }
                FFToast { toast-open: true; kind: "warning"; title: "Brightness target limited"; }
                FFToast { toast-open: true; kind: "failure"; title: "Could not save project"; }
            }
            HorizontalLayout {
                spacing: Theme.space-6;
                alignment: start;
                FFToast { toast-open: true; kind: "crash"; title: "Previous session stopped"; }
                FFToast { toast-open: true; kind: "warning"; title: "Brightness target limited"; hovered: true; }
                FFToast { toast-open: true; kind: "warning"; title: "Brightness target limited"; focused: true; }
            }
            HorizontalLayout {
                spacing: Theme.space-6;
                alignment: start;
                FFNotificationGlyph { kind: "info"; }
                FFNotificationGlyph { kind: "warning"; }
                FFNotificationGlyph { kind: "failure"; }
                FFNotificationGlyph { kind: "crash"; }
            }
        }

        GroupHeading { text: "Icon button: badge 0, 3, 12, 128; focus"; }
        HorizontalLayout {
            spacing: Theme.space-4;
            alignment: start;
            FFIconButton { icon: @image-url("../../../assets/icons/bell.svg"); focusable: true; }
            FFIconButton { icon: @image-url("../../../assets/icons/bell.svg"); focusable: true; badge: 3; }
            FFIconButton { icon: @image-url("../../../assets/icons/bell.svg"); focusable: true; badge: 12; }
            FFIconButton { icon: @image-url("../../../assets/icons/bell.svg"); focusable: true; badge: 128; }
            FFIconButton { icon: @image-url("../../../assets/icons/bell.svg"); focusable: true; badge: 3; focused: true; }
            FFIconButton { icon: @image-url("../../../assets/icons/settings.svg"); focusable: true; focused: true; }
        }

        GroupHeading { text: "Icon bar and raised nav rail"; }
        HorizontalLayout {
            spacing: Theme.space-6;
            alignment: start;
            FFNavRail {
                width: ShellGeometry.icon-bar-width;
                height: 160px;
                end-aligned: true;
                raised: true;
                FFIconButton { icon: @image-url("../../../assets/icons/bell.svg"); focusable: true; badge: 3; }
                FFIconButton { icon: @image-url("../../../assets/icons/settings.svg"); focusable: true; }
            }
            FFNavRail {
                width: ShellGeometry.icon-bar-width;
                height: 160px;
                end-aligned: true;
                raised: true;
                FFIconButton { icon: @image-url("../../../assets/icons/bell.svg"); focusable: true; filled: true; }
                FFIconButton { icon: @image-url("../../../assets/icons/settings.svg"); focusable: true; }
            }
            FFNavRail {
                width: 120px;
                height: 160px;
                raised: true;
                FFNavRailEntry {
                    label: "Storage";
                    icon-source: @image-url("../../../assets/icons/hard-drive.svg");
                    selected: true;
                }
                FFNavRailEntry {
                    label: "About";
                    icon-source: @image-url("../../../assets/icons/info.svg");
                }
            }
        }

        GroupHeading { text: "FFNotificationRow: summaries, selected + focus, 40-line message"; }
        HorizontalLayout {
            spacing: Theme.space-4;
            alignment: start;
            CenterGround {
                height: 520px;
                FFNotificationRow { kind: "info"; title: "Some images were skipped"; context: "Import · Mantis · 16:42"; }
                FFNotificationRow {
                    kind: "warning";
                    title: "Brightness target limited";
                    context: "Mantis · IMG_9823.tif · 16:41";
                    message: "Requested gain 1.67; maximum 1.25 applied. This source did not reach the target.\n\nThe original source file is unchanged.";
                    selected: true;
                    expanded: true;
                    focused: true;
                }
                FFNotificationRow { kind: "failure"; title: "Could not save project"; context: "Save · Mantis · mantis.ffp · 16:39"; }
                FFNotificationRow { kind: "crash"; title: "Previous session stopped"; context: "Startup · 1 crash report · 16:40"; }
            }
            CenterGround {
                height: 520px;
                FFNotificationRow {
                    kind: "info";
                    title: "Some images were skipped";
                    context: "Import · Mantis · 16:42";
                    message: "Skipped source files:\n~/Pictures/Mantis/session-2026-10-11/IMG_9824-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9825-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9826-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9827-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9828-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9829-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9830-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9831-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9832-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9833-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9834-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9835-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9836-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9837-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9838-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9839-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9840-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9841-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9842-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9843-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9844-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9845-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9846-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9847-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9848-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9849-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9850-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9851-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9852-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9853-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9854-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9855-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9856-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9857-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9858-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9859-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9860-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9861-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9862-source-original.tif\n~/Pictures/Mantis/session-2026-10-11/IMG_9863-source-original.tif";
                    selected: true;
                    expanded: true;
                }
            }
        }

        GroupHeading { text: "FFNotificationRow crash: unacknowledged, failed, unavailable, acknowledged"; }
        VerticalLayout {
            spacing: Theme.space-4;
            HorizontalLayout {
                spacing: Theme.space-4;
                alignment: start;
                CenterGround {
                    height: 420px;
                    FFNotificationRow {
                        kind: "crash";
                        title: "Previous session stopped";
                        context: "Startup · 1 crash report · 16:40";
                        message: "A previous session stopped unexpectedly. One crash report was detected at startup.\n\nReading or closing this notice does not acknowledge the report.";
                        selected: true;
                        expanded: true;
                        crash-state: "unacknowledged";
                    }
                }
                CenterGround {
                    height: 420px;
                    FFNotificationRow {
                        kind: "crash";
                        title: "Previous session stopped";
                        context: "Startup · 1 crash report · 16:40";
                        message: "A previous session stopped unexpectedly. One crash report was detected at startup.\n\nReading or closing this notice does not acknowledge the report.";
                        selected: true;
                        expanded: true;
                        crash-state: "failed";
                        crash-error: "Permission denied (os error 13)";
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-4;
                alignment: start;
                CenterGround {
                    height: 420px;
                    FFNotificationRow {
                        kind: "crash";
                        title: "Previous session stopped";
                        context: "Startup · 1 crash report · 16:40";
                        message: "A previous session stopped unexpectedly. One crash report was detected at startup.\n\nReading or closing this notice does not acknowledge the report.";
                        selected: true;
                        expanded: true;
                        crash-state: "unavailable";
                    }
                }
                CenterGround {
                    height: 420px;
                    FFNotificationRow {
                        kind: "crash";
                        title: "Previous session stopped";
                        context: "Startup · 1 crash report · 16:40";
                        message: "This crash report was acknowledged. Its original notification remains available for this session.";
                        selected: true;
                        expanded: true;
                        crash-state: "acknowledged";
                    }
                }
            }
        }

        GroupHeading { text: "Source presentations: List, Image list and Large previews"; }
        Rectangle {
            width: 3 * ShellGeometry.image-row-band-width + 2 * Theme.space-4;
            height: ShellGeometry.image-header-height + 2 * ShellGeometry.large-preview-row-height;

            GroupHeading { x: 0px; y: 0px; width: ShellGeometry.image-row-band-width; height: ShellGeometry.image-header-height; text: "LIST"; }
            FFImageRow { x: 0px; y: ShellGeometry.image-header-height; width: ShellGeometry.image-row-band-width; chip: Theme.status-warning; name: "IMG_9819.tif"; time-text: "16:42:09"; selected: true; }
            FFImageRow { x: 0px; y: ShellGeometry.image-header-height + ShellGeometry.image-row-height; width: ShellGeometry.image-row-band-width; chip: Theme.status-success; name: "IMG_9820.tif"; time-text: ""; excluded: true; hovered: true; }
            FFImageRow { x: 0px; y: ShellGeometry.image-header-height + 2 * ShellGeometry.image-row-height; width: ShellGeometry.image-row-band-width; chip: Theme.status-warning; name: "IMG_9823.tif"; time-text: ""; unresolved: true; focused: true; }
            FFImageRow { x: 0px; y: ShellGeometry.image-header-height + 3 * ShellGeometry.image-row-height; width: ShellGeometry.image-row-band-width; chip: Theme.accent-default; name: "IMG_9819-long-filename.tif"; time-text: "16:42:09"; dragging: true; }
            FFDragLandingMarker { x: 0px; y: ShellGeometry.image-header-height + 4 * ShellGeometry.image-row-height; }

            GroupHeading { x: ShellGeometry.image-row-band-width + Theme.space-4; y: 0px; width: ShellGeometry.image-row-band-width; height: ShellGeometry.image-header-height; text: "IMAGE LIST"; }
            FFImageRow { x: ShellGeometry.image-row-band-width + Theme.space-4; y: ShellGeometry.image-header-height; width: ShellGeometry.image-row-band-width; presentation: "image-list"; preview: @image-url("../../../assets/build/social-preview-dark.png"); chip: Theme.status-warning; name: "IMG_9819.tif"; time-text: "11.10.26 16:42"; selected: true; hovered: true; }
            FFImageRow { x: ShellGeometry.image-row-band-width + Theme.space-4; y: ShellGeometry.image-header-height + ShellGeometry.image-list-row-height; width: ShellGeometry.image-row-band-width; presentation: "image-list"; chip: Theme.status-success; name: "IMG_9821.tif"; time-text: ""; preview-state: "loading"; focused: true; }
            FFImageRow { x: ShellGeometry.image-row-band-width + Theme.space-4; y: ShellGeometry.image-header-height + 2 * ShellGeometry.image-list-row-height; width: ShellGeometry.image-row-band-width; presentation: "image-list"; chip: Theme.status-failure; name: "IMG_9823.tif"; time-text: ""; preview-state: "missing"; unresolved: true; }

            GroupHeading { x: 2 * (ShellGeometry.image-row-band-width + Theme.space-4); y: 0px; width: ShellGeometry.image-row-band-width; height: ShellGeometry.image-header-height; text: "LARGE PREVIEWS"; }
            FFImageRow { x: 2 * (ShellGeometry.image-row-band-width + Theme.space-4); y: ShellGeometry.image-header-height; width: ShellGeometry.image-row-band-width; presentation: "large"; preview: @image-url("../../../assets/build/social-preview-dark.png"); chip: Theme.status-warning; name: "IMG_9819.tif"; time-text: "16:42:09"; selected: true; hovered: true; }
            FFImageRow { x: 2 * (ShellGeometry.image-row-band-width + Theme.space-4); y: ShellGeometry.image-header-height + ShellGeometry.large-preview-row-height; width: ShellGeometry.image-row-band-width; presentation: "large"; chip: Theme.status-success; name: "IMG_9821.tif"; time-text: ""; preview-state: "unavailable"; job-disabled: true; focused: true; }
        }

        GroupHeading { text: "Source presentations: empty, tooltip, presentation menu and save error"; }
        Rectangle {
            width: 860px;
            height: 220px;
            FFPanePlaceholder { x: 0px; y: 0px; title: "No source images"; body: "Add images to begin."; action-label: "Add images"; }
            FFMenu { x: 240px; y: 0px; width: ShellGeometry.settings-field-width; label: "Image list"; choices: ["List", "Image list", "Large previews"]; choice-ids: ["list", "image-list", "large"]; show-choice-ids: false; selected: "image-list"; open: true; focused: true; }
            FFErrorRow { x: 400px; y: 0px; width: ShellGeometry.settings-content-width; message: "Could not save settings. Selected view remains active."; show-icon: true; }
            FFTooltip { x: 400px; y: 48px; tooltip-max-width: parent.width - self.x; text: "IMG_9819-long-filename.tif"; }
            FFTooltip { x: 400px; y: 120px; tooltip-max-width: parent.width - self.x; text: "IMG_9819.tif"; }
        }

        GroupHeading { text: "Settings: nav rail, entry default / hover / focus / selected"; }
        FFNavRail {
            height: ShellGeometry.settings-rail-top-inset + 4 * ShellGeometry.settings-rail-entry-height;
            FFNavRailEntry {
                label: "Storage";
                icon-source: @image-url("../../../assets/icons/hard-drive.svg");
            }
            FFNavRailEntry {
                label: "Storage";
                icon-source: @image-url("../../../assets/icons/hard-drive.svg");
                hovered: true;
            }
            FFNavRailEntry {
                label: "Storage";
                icon-source: @image-url("../../../assets/icons/hard-drive.svg");
                focused: true;
            }
            FFNavRailEntry {
                label: "Storage";
                icon-source: @image-url("../../../assets/icons/hard-drive.svg");
                selected: true;
            }
        }

        GroupHeading { text: "Settings: nav rail, the live entries"; }
        FFNavRail {
            height: ShellGeometry.settings-rail-top-inset + 2 * ShellGeometry.settings-rail-entry-height;
            FFNavRailEntry {
                label: "Input map";
                icon-source: @image-url("../../../assets/icons/keyboard.svg");
                selected: true;
            }
            FFNavRailEntry {
                label: "Diagnostics";
                icon-source: @image-url("../../../assets/icons/triangle-alert.svg");
            }
        }

        GroupHeading { text: "Settings: section, path rows (present, present, missing, present)"; }
        SettingsGround {
            FFSettingsSection {
                heading: "LOCATIONS";
                FFSettingsPathRow {
                    label: "Settings file";
                    path: "~/.config/focusforge/settings.toml";
                }
                FFSettingsPathRow { label: "Logs"; path: "~/.local/share/focusforge/logs"; }
                FFSettingsPathRow {
                    label: "Crash reports";
                    path: "~/.local/share/focusforge/crashes";
                    missing: true;
                }
                FFSettingsPathRow {
                    label: "Scratch";
                    path: "~/.local/share/focusforge/scratch";
                    divider: false;
                }
            }
        }

        GroupHeading { text: "Settings: path rows, long path elided, long path and missing (suffix whole), unavailable"; }
        SettingsGround {
            FFSettingsSection {
                heading: "LOCATIONS";
                FFSettingsPathRow {
                    label: "Scratch";
                    path: "/mnt/photography/2026/mantis-series/session-three/focusforge/scratch";
                }
                FFSettingsPathRow {
                    label: "Scratch";
                    path: "/mnt/photography/2026/mantis-series/session-three/focusforge/scratch";
                    missing: true;
                }
                FFSettingsPathRow { label: "Settings file"; available: false; }
                FFSettingsPathRow { label: "Logs"; available: false; divider: false; }
            }
        }

        GroupHeading { text: "Settings: Performance rows, default (toggle on, backend, empty caps showing the placeholder, budgets, note)"; }
        SettingsGround {
            VerticalLayout {
                spacing: ShellGeometry.settings-section-gap;

                FFSettingsSection {
                    heading: "PROCESSING";
                    FFSettingsRow {
                        label: "GPU processing";
                        align-end: true;
                        FFToggle { on: true; }
                    }
                    FFSettingsRow {
                        label: "Backend";
                        FFRowText { text: "gpu — NVIDIA GeForce RTX 5070 Ti"; overflow: elide; }
