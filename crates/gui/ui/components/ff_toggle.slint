//
// A two-state switch: a rectangular, neutral track holding one coloured
// segment, half the track's width, that slides between its left and right
// slot and changes colour in the same motion -- the slide is the state
// signal, the colour change happens alongside it rather than as a
// separate cue. A keyboard-focus ring grows the whole control by 2 px on
// every edge instead of drawing inside it, so a focused toggle in a tight
// column pushes nothing around it.

import { Theme } from "../theme.slint";

export component FFToggle inherits FocusScope {
    in property <bool> checked: false;
    callback toggled(bool);

    width: root.has-focus ? 40px : 36px;
    height: root.has-focus ? 24px : 20px;
    opacity: root.enabled ? 1.0 : 0.5;

    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-md;
        border-width: root.has-focus ? 2px : 0px;
        border-color: Theme.accent-default;
    }

    track := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 36px;
        height: 20px;
        background: Theme.surface-overlay;
        border-radius: Theme.radius-md;
        clip: true;

        segment := Rectangle {
            width: parent.width / 2;
            height: parent.height;
            x: root.checked ? parent.width - self.width : 0px;
            background: root.checked ? Theme.status-success : Theme.accent-default;
            animate x { duration: 300ms; easing: ease-in-out; }
            animate background { duration: 300ms; easing: ease-in-out; }
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(!root.checked); }
    }
}
