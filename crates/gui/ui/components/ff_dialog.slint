//
// A modal dialog: a scrim, a card with an optional warning icon and title,
// a body paragraph, an optional info line, and its own footer.

import { Theme } from "../theme.slint";
import { FFDialogFooter } from "ff_dialog_footer.slint";

export component FFDialog inherits Rectangle {
    in property <bool> open: false;
    // "warning" (a red top rule and triangle icon) | "plain".
    in property <string> tone: "plain";
    in property <string> title: "";
    in property <string> body: "";
    // Empty hides the info line.
    in property <string> info: "";
    in property <string> secondary-label: "";
    in property <string> confirm-label: "Confirm";
    in property <string> confirm-kind: "primary";
    callback cancelled();
    callback secondary-pressed();
    callback confirmed();

    visible: root.open;
    width: 100%;
    height: 100%;

    scrim := Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface-canvas.with-alpha(0.6);
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 480px;
        height: 300px;
        background: Theme.surface-raised;
        border-radius: Theme.radius-lg;

        if root.tone == "warning": Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 2px;
            background: Theme.status-failure;
        }

        VerticalLayout {
            padding: Theme.space-4;
            spacing: Theme.space-3;

            // Everything above the footer, packed from the top and given
            // the whole panel's leftover height -- however little of it
            // the body actually uses, the footer below stays pinned to the
            // panel's own bottom edge instead of floating wherever the
            // content happens to end.
            VerticalLayout {
                spacing: Theme.space-3;
                alignment: start;
                vertical-stretch: 1;

                HorizontalLayout {
                    spacing: Theme.space-2;

                    if root.tone == "warning": Image {
                        source: @image-url("../../../../assets/icons/triangle-alert.svg");
                        colorize: Theme.status-failure;
                        width: Theme.icon-md;
                        height: Theme.icon-md;
                    }
                    Text {
                        text: root.title;
                        color: Theme.text-primary;
                        font-size: Theme.text-title.size;
                        font-weight: Theme.text-title.weight;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }

                Text {
                    text: root.body;
                    color: Theme.text-secondary;
                    font-size: Theme.text-body.size;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-default;
                }

                if root.info != "": HorizontalLayout {
                    spacing: Theme.space-1;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 2px;
                        Image {
                            source: @image-url("../../../../assets/icons/info.svg");
                            colorize: Theme.text-disabled;
                            width: Theme.icon-sm;
                            height: Theme.icon-sm;
                        }
                    }
                    Text {
                        text: root.info;
                        color: Theme.text-disabled;
                        font-size: Theme.text-body.size;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }

            FFDialogFooter {
                secondary-label: root.secondary-label;
                confirm-label: root.confirm-label;
                confirm-kind: root.confirm-kind;
                cancelled => { root.cancelled(); }
                secondary-pressed => { root.secondary-pressed(); }
                confirmed => { root.confirmed(); }
            }
        }
    }
}
