//
// A labelled button with an optional leading glyph, in two heights and four
// tones.

import { Theme } from "../theme.slint";
import { ShellGeometry } from "../geometry.slint";

export component FFButton inherits Rectangle {
    // "primary" | "default" | "quiet" | "danger".
    in property <string> kind: "default";
    // The bar height (`ShellGeometry.toolbar-button-height`); the taller,
    // 34 px default otherwise.
    in property <bool> compact: false;
    in property <string> text;
    // A single leading glyph, 16 px wide; no glyph column when empty.
    in property <string> glyph: "";
    in property <bool> enabled: true;
    callback clicked();

    property <color> label-color: (root.kind == "primary" || root.kind == "danger")
        ? Theme.text-on-accent
        : root.kind == "quiet" ? Theme.text-muted : Theme.text-primary;

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;

    height: root.compact ? ShellGeometry.toolbar-button-height : 34px;
    border-radius: Theme.radius-sm;
    background: root.kind == "primary" ? Theme.accent-default
        : root.kind == "danger" ? Theme.status-failure
        : root.kind == "quiet" ? transparent
        : Theme.surface-overlay;
    opacity: root.enabled ? 1.0 : 0.5;

    area := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: Theme.space-1;

        if root.glyph != "": Text {
            text: root.glyph;
            width: 16px;
            color: root.label-color;
            font-size: Theme.text-body.size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: root.label-color;
            font-size: Theme.text-body.size;
            font-weight: Theme.text-body.weight;
            vertical-alignment: center;
        }
    }
}
