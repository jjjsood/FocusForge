//
// A modal's own scrim and centered panel -- every dialog's shared shell,
// its content placed as this component's children.

import { Theme } from "../theme.slint";
import { FFIconButton } from "ff_icon_button.slint";

export component FFModalPanel inherits Rectangle {
    in property <bool> modal-open: false;
    in property <length> panel-width: 480px;
    in property <length> panel-height: 300px;
    // "none" | "warning" (a red top rule) | "caution" (an amber top rule).
    in property <string> tone-rule: "none";
    in property <bool> clip-panel: false;
    // A close control at the panel's top right, raising `close-requested`.
    in property <bool> show-close: false;
    // Halves the close control's opacity; it stays clickable.
    in property <bool> close-dimmed: false;
    // The width a title row keeps free so its text wraps before the control.
    out property <length> close-reserve: root.show-close ? Theme.icon-md + 2 * Theme.space-2 : 0px;
    callback close-requested();

    visible: root.modal-open;
    width: 100%;
    height: 100%;

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface-canvas.with-alpha(0.6);

        TouchArea {
            width: 100%;
            height: 100%;
            scroll-event(e) => { accept }
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.panel-width;
        height: root.panel-height;
        background: Theme.surface-raised;
        border-radius: Theme.radius-lg;
        clip: root.clip-panel;
        // Lifts the panel off the scrim -- the same recipe `FFLoadingPanel`
        // and `FFImageRow`'s floating state use.
        drop-shadow-color: Theme.surface-canvas.with-alpha(0.5);
        drop-shadow-offset-y: Theme.space-1;
        drop-shadow-blur: Theme.space-2;

        if root.tone-rule == "warning": Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 2px;
            background: Theme.status-failure;
        }
        if root.tone-rule == "caution": Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 2px;
            background: Theme.status-warning;
        }

        @children

        if root.show-close: FFIconButton {
            // The glyph's right edge lines up with the content inset; the
            // button is centred on a `Theme.icon-lg` row at that inset.
            x: parent.width - Theme.space-4 - Theme.icon-md - self.pad;
            y: Theme.space-4 + (Theme.icon-lg - self.height) / 2;
            icon: @image-url("../../../../assets/icons/x.svg");
            name: "Close dialog";
            opacity: root.close-dimmed ? 0.5 : 1.0;
            triggered => { root.close-requested(); }
        }
    }
}
