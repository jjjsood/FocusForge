//
// A section's `More...` header: a flat tinted strip that opens and closes
// the advanced rows below it. Its own `height` is the header while closed and
// the header plus the rows it holds while open; the strip tint reaches down
// behind those rows.

import { Theme } from "../theme.slint";
import { ShellGeometry } from "../geometry.slint";

export component FFMoreToggle inherits Rectangle {
    in property <bool> open: false;
    in property <bool> disabled: false;
    // Drawn as pointer-over; a live pointer over the header also sets it.
    in property <bool> hovered: false;
    in property <bool> focused: false;
    callback toggled();

    property <color> ink: root.disabled ? Theme.text-disabled : Theme.text-secondary;

    background: !root.disabled && (root.hovered || header-area.has-hover) ? Theme.border-default : Theme.surface-hover;

    Text {
        x: Theme.space-3;
        y: 0px;
        height: ShellGeometry.more-height;
        text: "More...";
        color: root.disabled ? Theme.text-disabled : Theme.text-primary;
        font-size: Theme.text-value.size;
        font-weight: Theme.text-value.weight;
        vertical-alignment: center;
    }

    Path {
        x: parent.width - Theme.space-3 - self.width;
        y: (ShellGeometry.more-height - self.height) / 2;
        width: Theme.icon-md;
        height: Theme.icon-md;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.open ? "M 4 10 L 8 6 L 12 10" : "M 4 6 L 8 10 L 12 6";
        stroke: root.ink;
        stroke-width: 2px;
    }

    if root.focused: Rectangle {
        width: 100%;
        height: 100%;
        border-width: 2px;
        border-color: Theme.accent-default;
    }

    header-area := TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: ShellGeometry.more-height;
        enabled: !root.disabled;
        accessible-role: button;
        accessible-label: "More...";
        accessible-enabled: !root.disabled;
        clicked => { root.toggled(); }
    }
}
