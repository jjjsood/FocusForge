//
// Fades its content in when `shown` turns true (and on creation) and, with
// `fade-out`, back out when it turns false. From the first frame of an exit
// a cover over everything it draws swallows clicks and scrolls.

import { Theme } from "../theme.slint";

export component FFAppear inherits Rectangle {
    in property <bool> shown: true;
    // Keeps the element drawn while it fades out; without it the exit is a cut.
    in property <bool> fade-out: false;
    // Fades on `Theme.motion-slow` instead of `Theme.motion-fast`.
    in property <bool> slow: false;

    property <bool> started: false;

    opacity: root.started && root.shown ? 1 : 0;
    animate opacity {
        duration: root.slow ? Theme.motion-slow : Theme.motion-fast;
        easing: ease-out;
    }
    visible: root.shown || (root.fade-out && self.opacity > 0);
    init => { root.started = true; }

    @children

    TouchArea {
        visible: !root.shown;
        width: 100%;
        height: 100%;
        scroll-event(e) => { accept }
    }
}
