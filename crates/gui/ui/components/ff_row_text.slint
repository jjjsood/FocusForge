//
// A row's own inline text: a resolved value, or with `muted` a caption beside
// a control. `accent` draws it in the accent colour.

import { Theme } from "../theme.slint";

export component FFRowText inherits Text {
    in property <bool> muted: false;
    in property <bool> accent: false;

    color: root.accent ? Theme.accent-default : root.muted ? Theme.text-muted : Theme.text-primary;
    font-size: Theme.text-value.size;
    vertical-alignment: center;
}
