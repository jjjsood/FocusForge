// SPDX-License-Identifier: GPL-3.0-or-later
//
// One frame in the `Images` list: a legend chip, its name and capture time,
// with a grip/eye/bin revealed on hover.

import { Theme } from "../theme.slint";
import { ShellGeometry } from "../geometry.slint";

export component FFImageRow inherits Rectangle {
    in property <color> chip;
    in property <string> name;
    in property <string> time-text;
    in property <bool> excluded: false;
    // The recorded source is no longer a file on disk -- greyed, no
    // controls, never draggable.
    in property <bool> unresolved: false;
    // This row is the one being dragged to a new position.
    in property <bool> dragging: false;
    // Forces the hover visual for the component sheet; a live row also
    // shows it under the pointer.
    in property <bool> hovered: false;
    // Whether this row's grip/eye/bin ever show at all -- `false` for the
    // read-only shape a non-stacking surface reuses.
    in property <bool> mutable: true;
    // A copy of this row floating above the list rather than in its own
    // slot -- softened and shadowed so it reads as lifted off the surface
    // instead of a second solid row.
    in property <bool> floating: false;

    callback exclude-toggled();
    callback remove-requested();
    // The grip's own raw pointer stream (0 = down, 1 = up, 2 = move; the
    // same fold `ff_scrollbar.slint`'s `pointer` uses), `y` relative to this
    // row's own top edge -- the panel/controller decide what a drag means.
    callback grip-pointer(int, length);

    height: ShellGeometry.image-row-height;
    opacity: root.floating ? 0.75 : 1.0;
    drop-shadow-color: root.floating ? Theme.surface-canvas.with-alpha(0.5) : transparent;
    drop-shadow-offset-y: Theme.space-1;
    drop-shadow-blur: Theme.space-2;

    property <bool> interactive: !root.unresolved && root.mutable;
    property <bool> show-controls: root.interactive && !root.dragging && (root.hovered || area.has-hover);
    // The grip's touch surface must stay mounted for the whole gesture it
    // starts, including while `dragging` hides its icon -- tearing it down
    // mid-grab (as `show-controls` alone would) drops the release the drag
    // needs to land.
    property <bool> grip-mounted: root.interactive && (root.dragging || root.hovered || area.has-hover);
    property <color> label-color: root.unresolved ? Theme.text-disabled
        : root.excluded ? Theme.text-muted
        : Theme.text-primary;
    property <color> time-color: root.unresolved ? Theme.text-disabled : Theme.text-muted;

    background: root.dragging || (root.interactive && area.has-hover) ? Theme.surface-hover : transparent;

    // The grip and the eye/bin nest inside this TouchArea rather than
    // sitting beside it: a sibling TouchArea occludes `area`'s own hover
    // the instant the pointer sits over it (Slint delivers a move to
    // exactly one item at a point), which would drop `area.has-hover` --
    // and with it every control depending on it -- the moment the pointer
    // reaches the control it is about to press. Nested, `area`'s own
    // `input_event_filter_before_children` still runs on the way down to
    // whichever child ends up handling the event, so its hover survives.
    area := TouchArea {
        enabled: root.interactive;
        width: 100%;
        height: 100%;

        // The grip -- the row's own drag handle, in the gutter before the
        // chip.
        if root.grip-mounted: grip-area := TouchArea {
            x: 0;
            width: ShellGeometry.image-row-content-inset;
            height: 100%;
            pointer-event(event) => {
                root.grip-pointer(event.kind == PointerEventKind.down ? 0 : (event.kind == PointerEventKind.move ? 2 : 1), self.mouse-y);
            }

            if !root.dragging: Image {
                source: @image-url("../../../../assets/icons/grip-vertical.svg");
                colorize: Theme.text-muted;
                width: Theme.icon-sm;
                height: Theme.icon-sm;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        // The eye and bin -- past the content column, in the trailing
        // gutter and over where the capture time would otherwise sit. Kept
        // clear of the panel's own scrollbar track, which sits flush on the
        // row's right edge.
        if root.show-controls: HorizontalLayout {
            width: 2 * Theme.icon-sm + Theme.space-1;
            x: parent.width - self.width - Theme.space-1 - ShellGeometry.scrollbar-width;
            height: 100%;
            spacing: Theme.space-1;

            exclude-area := TouchArea {
                width: Theme.icon-sm;
                clicked => { root.exclude-toggled(); }
                Image {
                    source: root.excluded
                        ? @image-url("../../../../assets/icons/eye-off.svg")
                        : @image-url("../../../../assets/icons/eye.svg");
                    colorize: Theme.text-secondary;
                    width: Theme.icon-sm;
                    height: Theme.icon-sm;
                    y: (parent.height - self.height) / 2;
                }
            }
            remove-area := TouchArea {
                width: Theme.icon-sm;
                clicked => { root.remove-requested(); }
                Image {
                    source: @image-url("../../../../assets/icons/trash.svg");
                    colorize: Theme.status-failure;
                    width: Theme.icon-sm;
                    height: Theme.icon-sm;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }

    // The drop-position indicator -- never shown alongside the hover
    // controls, since a row mid-drag shows no grip/eye/bin of its own.
    if root.dragging: Rectangle {
        x: 0;
        width: 4px;
        height: 100%;
        background: Theme.accent-default;
    }

    content := HorizontalLayout {
        x: ShellGeometry.image-row-content-inset;
        width: ShellGeometry.image-row-content-width;
        height: 100%;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: ShellGeometry.image-chip-size;
                height: ShellGeometry.image-chip-size;
                border-radius: Theme.radius-sm;
                background: root.chip;
                opacity: root.excluded || root.unresolved ? 0.4 : 1.0;
            }
        }

        Text {
            text: root.name;
            color: root.label-color;
            font-size: Theme.text-body.size;
            font-weight: Theme.text-body.weight;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if !root.show-controls: Text {
            text: root.time-text == "" ? "—" : root.time-text;
            color: root.time-color;
            font-size: Theme.text-body.size;
            font-weight: Theme.text-body.weight;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}
