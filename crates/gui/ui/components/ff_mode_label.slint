//
// A mode switch label: its colour moves from the muted text colour to the
// on-accent colour as the sliding pill covers it.

import { Theme } from "../theme.slint";

export component FFModeLabel inherits Text {
    // How much of the label the pill covers, 0 to 1.
    in property <float> cover: 0.0;
    in property <bool> disabled: false;

    width: 100%;
    height: 100%;
    horizontal-alignment: center;
    vertical-alignment: center;
    font-size: Theme.text-section.size;
    font-weight: Theme.text-section.weight;
    letter-spacing: Theme.text-section.letter-spacing;
    color: Theme.text-on-accent.mix(root.disabled ? Theme.text-disabled : Theme.text-muted, root.cover);
}
