//
// The brush cursor: a dashed ring at the radius around a solid core, or,
// while picking, the pipette icon beside a swatch of the colour it would pick.
// A checkpoint source draws the ring in `text-primary` with a layers glyph at
// the centre.

import { Theme } from "../theme.slint";
import { ShellGeometry } from "../geometry.slint";

export component FFBrushCursor inherits Rectangle {
    // Side of the square the path commands are drawn in, in logical px; the
    // cursor's centre is the centre of that square.
    in property <length> extent;
    // One sub-path per dash of the radius ring; empty for a hard brush.
    in property <string> ring-commands;
    in property <string> core-commands;
    in property <bool> picking: false;
    in property <color> pick-color;
    // The mode chip's letter (empty draws no chip) and its top-left on both
    // axes of the square.
    in property <string> mode-tag: "";
    in property <length> tag-origin;
    // The brush source is a checkpoint: a `text-primary` ring around the
    // layers glyph in `glyph-color`. Picking takes precedence.
    in property <bool> checkpoint-source: false;
    in property <color> glyph-color;

    property <bool> checkpoint-look: root.checkpoint-source && !root.picking;
    property <color> ink: root.checkpoint-look ? Theme.text-primary : Theme.cursor-ink;

    width: root.extent;
    height: root.extent;

    if !root.picking: Path {
        width: root.extent;
        height: root.extent;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.extent / 1px;
        viewbox-height: root.extent / 1px;
        commands: root.ring-commands;
        stroke: root.ink.with-alpha(root.checkpoint-look ? 0.9 : 0.7);
        stroke-width: 1px;
    }
    if !root.picking: Path {
        width: root.extent;
        height: root.extent;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.extent / 1px;
        viewbox-height: root.extent / 1px;
        commands: root.core-commands;
        stroke: root.ink;
        stroke-width: 1px;
    }

    if root.checkpoint-look: Image {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: ShellGeometry.cursor-glyph-side;
        height: ShellGeometry.cursor-glyph-side;
        source: @image-url("../../../../assets/icons/layers.svg");
        colorize: root.glyph-color;
    }

    // The active brush mode's one-letter chip, outside the ring at its
    // lower-right; hidden while picking.
    if !root.picking && root.mode-tag != "": Rectangle {
        x: root.tag-origin;
        y: root.tag-origin;
        width: ShellGeometry.brush-tag-side;
        height: ShellGeometry.brush-tag-side;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border-default;
        border-radius: Theme.radius-sm;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.mode-tag;
            color: Theme.text-primary;
            font-size: Theme.text-value.size;
            font-weight: Theme.text-value.weight;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.picking: Image {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: Theme.icon-lg;
        height: Theme.icon-lg;
        source: @image-url("../../../../assets/icons/pipette-cursor.svg");
        colorize: root.ink;
    }
    // Swatch previewing the colour about to be picked up, offset to the
    // icon's bottom-right corner so it reads as separate from the icon.
    if root.picking: Rectangle {
        width: 8px;
        height: 8px;
        x: (root.width - Theme.icon-lg) / 2 + Theme.icon-lg;
        y: (root.height - Theme.icon-lg) / 2 + Theme.icon-lg - self.height;
        background: root.pick-color;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-default;
    }
}
