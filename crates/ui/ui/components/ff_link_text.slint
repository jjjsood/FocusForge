//
// Clickable accent text: underlined under the pointer, reachable with Tab and
// drawn with a 1 px accent ring while focused; Return or a click emits
// `activated`.

import { Theme } from "../theme.slint";
import { FFRowText } from "ff_row_text.slint";

export component FFLinkText inherits Rectangle {
    in property <string> text: "";
    // Drawn without the pointer or the keyboard being there, as `FFToast`'s
    // own `hovered` and `focused` are.
    in property <bool> hovered: false;
    in property <bool> focused: false;
    out property <bool> has-hover: area.has-hover;
    out property <bool> has-focus: key.has-focus;
    callback activated();

    property <bool> ringed: root.focused || key.has-focus;

    preferred-width: label.preferred-width;
    max-width: label.preferred-width;
    preferred-height: label.preferred-height;

    label := FFRowText {
        width: 100%;
        height: 100%;
        text: root.text;
        accent: true;
    }

    if root.hovered || area.has-hover: Rectangle {
        y: parent.height - 3px;
        width: label.preferred-width;
        height: 1px;
        background: Theme.accent-default;
    }

    key := FocusScope {
        focus-on-click: false;
        KeyBinding {
            keys: @keys(Return);
            activated => { root.activated(); }
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }

    if root.ringed: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-width: 1px;
        border-color: Theme.accent-default;
    }
}
