// SPDX-License-Identifier: GPL-3.0-or-later
//
// One continuous, fractional-fill track for a run's whole progress.

import { Theme } from "../theme.slint";
import { ShellGeometry } from "../geometry.slint";

export component FFProgressBar inherits Rectangle {
    // 0.0..1.0 of the whole job, never per step.
    in property <float> fraction: 0.0;
    // "running" | "held" | "failed".
    in property <string> tone: "running";
    // A soft-edged band crosses the track left to right and starts again,
    // instead of the fractional fill, for work of unknown length. It fades
    // in and out when this changes.
    in property <bool> indeterminate: false;
    // Tracks stacked in one panel can share one band: `sweep-span` is the
    // width of the field the band crosses, `sweep-offset` where this track's
    // left edge sits in it, `sweep-lag` how far this track trails the pass.
    in property <length> sweep-offset: 0px;
    in property <length> sweep-span: root.width;
    in property <duration> sweep-lag: 0ms;
    in property <length> thickness: ShellGeometry.progress-bar-height;
    // Defaults to a pill.
    in property <length> corner-radius: root.thickness / 2;
    // The fractional fill's own timing.
    in property <duration> fill-delay: 0ms;
    in property <duration> fill-duration: Theme.motion-fast;

    property <color> ink: root.tone == "failed" ? Theme.status-failure
        : root.tone == "held" ? Theme.border-strong
        : Theme.accent-default;
    property <float> band-alpha: root.indeterminate ? 1.0 : 0.0;

    height: root.thickness;
    border-radius: root.corner-radius;
    background: Theme.surface-overlay;
    clip: true;

    animate band-alpha { duration: Theme.sweep-fade; easing: ease-out; }

    Rectangle {
        x: 0px;
        height: 100%;
        border-radius: parent.border-radius;
        background: root.ink;
        width: root.indeterminate ? 0px : parent.width * max(0.0, min(1.0, root.fraction));

        animate width { delay: root.fill-delay; duration: root.fill-duration; easing: ease-out; }
    }
    Rectangle {
        height: 100%;
        width: root.sweep-span * ShellGeometry.sweep-band-share;
        opacity: root.band-alpha;
        // Reads the clock only while the band shows, so a settled bar never
        // schedules a per-frame redraw.
        x: root.band-alpha > 0.0 ? Theme.sweep-x(root.sweep-lag, root.sweep-offset, root.sweep-span, self.width) : 0px;
        background: @linear-gradient(90deg,
            root.ink.with-alpha(0.0) 0%,
            root.ink ShellGeometry.sweep-band-edge,
            root.ink 1.0 - ShellGeometry.sweep-band-edge,
            root.ink.with-alpha(0.0) 100%);
    }
}
