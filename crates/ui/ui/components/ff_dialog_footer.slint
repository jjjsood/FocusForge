//
// A dialog's own button row: the quiet cancel button at the left, up to two
// optional secondary buttons and the confirm button grouped at the right. An
// empty `confirm-label` leaves the cancel button alone.

import { Theme } from "../theme.slint";
import { FFButton } from "ff_button.slint";

export component FFDialogFooter inherits Rectangle {
    in property <string> cancel-label: "Cancel";
    in property <string> secondary-label: "";
    // A second secondary button, drawn before the secondary one.
    in property <string> tertiary-label: "";
    in property <string> confirm-label: "Confirm";
    // "primary" | "danger" -- the confirm button's own tone.
    in property <string> confirm-kind: "primary";
    // Halves the footer's opacity without touching its buttons' own
    // `enabled` state -- a dialog mid-write still takes a click on either
    // button, just visually recessed while it does.
    in property <bool> dimmed: false;
    callback cancelled();
    callback secondary-pressed();
    callback tertiary-pressed();
    callback confirmed();

    height: 34px;
    opacity: root.dimmed ? 0.5 : 1.0;

    HorizontalLayout {
        alignment: space-between;

        FFButton {
            width: 70px;
            kind: "quiet";
            text: root.cancel-label;
            clicked => { root.cancelled(); }
        }

        HorizontalLayout {
            spacing: Theme.space-2;

            if root.tertiary-label != "": FFButton {
                width: 160px;
                kind: "default";
                text: root.tertiary-label;
                clicked => { root.tertiary-pressed(); }
            }
            if root.secondary-label != "": FFButton {
                width: 160px;
                kind: "default";
                text: root.secondary-label;
                clicked => { root.secondary-pressed(); }
            }
            if root.confirm-label != "": FFButton {
                width: 160px;
                kind: root.confirm-kind;
                text: root.confirm-label;
                clicked => { root.confirmed(); }
            }
        }
    }
}
